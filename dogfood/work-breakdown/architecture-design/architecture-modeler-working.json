        {
          "id": "EL-DEVRELAY-SYSTEM",
          "name": "DevRelay",
          "type": "software-system",
          "description": "Deterministic orchestration runtime for composable software-engineering modules.",
          "responsibilities": [
            "Progress exact approved artifacts through provider-neutral modules, gates, and trusted traceability."
          ],
          "tags": [
            "System"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-EXTENSIBILITY-001",
            "US-WB-GOVERNANCE-001",
