          "type": "component",
          "parentId": "EL-WB-MODULE",
          "description": "Derives the authoritative coverage universe, resolves evidence, owns no-work approval, and promotes approved planned work.",
          "technology": "Deterministic gate policy",
          "responsibilities": [
            "Reject unscoped or uncovered work.",
            "Approve or reject already-satisfied and no-work-required dispositions.",
            "Atomically promote a baseline or apply an exact typed delta."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-COVERAGE-001",
            "US-WB-DECOMPOSITION-001",
