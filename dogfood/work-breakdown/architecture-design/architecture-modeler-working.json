          "name": "Registered WorkBreakdown Preflight",
          "type": "component",
          "parentId": "EL-DEVRELAY-CORE",
          "description": "Generic guard registered on the loaded ProjectWorkBreakdownState artifact contract with its own persisted producer identity.",
          "technology": "Registered artifact-contract guard",
          "responsibilities": [
            "Detect exact baseline, disposition, revision, and tree drift before adapter entry.",
            "Schema-validate baseline_drift results.",
            "Checkpoint and replay the control result without adapter entry."
