          "technology": "JavaScript validation contracts",
          "responsibilities": [
            "Validate exact upstream artifacts in a WorkBreakdown-neutral context.",
            "Enforce approved absence unions and cross-artifact lineage."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-COVERAGE-001",
            "NFR-WB-DETERMINISM-001",
