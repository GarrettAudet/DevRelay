          "name": "WorkBreakdown Traceability Contributor",
          "type": "component",
          "parentId": "EL-DEVRELAY-GRAPH",
          "description": "Trusted projector of validated candidate work items into limited planning relationships.",
          "technology": "Trusted versioned contributor",
          "responsibilities": [
            "Create only approved planning edge kinds.",
            "Preserve candidate authority until gate activation.",
            "Never create inverse or factual completion edges."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-COVERAGE-001",
            "US-WB-GOVERNANCE-001",
