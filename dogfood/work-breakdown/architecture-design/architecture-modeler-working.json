        {
          "id": "EL-WB-MODULE",
          "name": "WorkBreakdown Module",
          "type": "container",
          "parentId": "EL-DEVRELAY-SYSTEM",
          "description": "Converts exact approved scope into bounded, traceable, independently executable and verifiable work-item candidates.",
          "technology": "JSON Schema and JavaScript",
          "responsibilities": [
            "Own establish-breakdown and decompose-change semantic contracts.",
            "Normalize configured planning adapter output.",
            "Return candidates without executing work."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-COVERAGE-001",
            "US-WB-DECOMPOSITION-001",
            "NFR-WB-DETERMINISM-001",
