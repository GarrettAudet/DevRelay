          ],
          "sourceRefs": []
        },
        {
          "id": "EL-DEVRELAY-CORE",
          "name": "Generic Core",
          "type": "container",
          "parentId": "EL-DEVRELAY-SYSTEM",
          "description": "Owns generic registration, state-derived routing, exact adapter resolution, checkpoints, replay, and progression.",
          "technology": "Node.js",
          "responsibilities": [
            "Load exact state and artifact contracts.",
            "Route without product-specific branches.",
            "Checkpoint and replay bounded effects and control results."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-EXTENSIBILITY-001",
