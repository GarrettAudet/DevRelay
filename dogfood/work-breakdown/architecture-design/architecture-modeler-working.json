          ],
          "sourceRefs": []
        },
        {
          "id": "EL-DEVRELAY-MODULES",
          "name": "Released Semantic Modules",
          "type": "container",
          "parentId": "EL-DEVRELAY-SYSTEM",
          "description": "Provider-neutral RequirementsGathering and ArchitectureDesign contracts extended by WorkBreakdown.",
          "technology": "JSON Schema and JavaScript",
          "responsibilities": [
            "Define stable ports, canonical artifacts, outcomes, and gate handoffs."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-DECOMPOSITION-001",
            "US-WB-EXTENSIBILITY-001",
            "NFR-WB-CORE-NEUTRALITY-001"
          ],
          "sourceRefs": []
        },
        {
          "id": "EL-DEVRELAY-GRAPH",
          "name": "TraceabilityGraph",
          "type": "container",
          "parentId": "EL-DEVRELAY-SYSTEM",
          "description": "Core-owned sidecar for trusted lifecycle traceability contributions and atomic merge proofs.",
          "technology": "Provider-neutral graph contract",
          "responsibilities": [
            "Replay approved upstream observer contributions.",
            "Keep candidate and approved authority distinct.",
            "Validate and atomically merge registered contributor updates."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-COVERAGE-001",
            "US-WB-GOVERNANCE-001",
            "NFR-WB-ATOMICITY-001",
