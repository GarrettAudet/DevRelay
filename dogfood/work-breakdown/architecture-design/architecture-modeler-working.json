          "responsibilities": [
            "Materialize approved upstream endpoints and authority.",
            "Forbid contract endpoints and contract refs when ApprovedNotApplicable is selected."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-COVERAGE-001",
            "US-WB-GOVERNANCE-001",
            "NFR-WB-PROVENANCE-001",
            "NFR-WB-REPLAY-001",
