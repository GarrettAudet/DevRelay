          "type": "component",
          "parentId": "EL-WB-MODULE",
          "description": "Provider-neutral port for one bounded work-decomposition capability selected by configuration.",
          "technology": "Agent-command bridge",
          "responsibilities": [
            "Invoke Spec Kit tasks, OpenSpec tasks, or a compatible planner through the same canonical contract.",
            "Allow read and planning-artifact output only."
          ],
          "tags": [
            "Container"
          ],
          "properties": {},
          "sourceRequirementIds": [
            "US-WB-EXTENSIBILITY-001",
            "NFR-WB-CORE-NEUTRALITY-001",
