  "decisions": [
    {
      "id": "D-BA-BOUNDARY-001",
      "statement": "BusinessAcceptanceGate is Core-owned authority with no adapter execution; external evidence collectors may be introduced later only as bounded upstream producers."
    },
    {
      "id": "D-BA-SUBJECT-001",
      "statement": "The acceptance subject binds the exact verified SystemVerificationResult, paired RequirementsBaseline and ProjectOverviewBaseline, ArchitectureBaseline, ContractDisposition, repository release snapshot, policy, business evidence, and TraceabilityGraph checkpoint."
    },
    {
      "id": "D-BA-COVERAGE-001",
      "statement": "Core exhaustively disposes every approved business objective and success metric as satisfied, failed, or needs-evidence and rejects omitted, duplicate, or unapproved scope."
    },
    {
      "id": "D-BA-APPROVAL-001",
      "statement": "Evidence evaluation produces a candidate only; a separate exact owner approval over raw candidate bytes produces the authoritative BusinessAcceptanceRecord."
    },
    {
      "id": "D-BA-OUTCOMES-001",
      "statement": "Closed outcomes are accepted, rejected, needs-evidence, baseline-drift, and unable-to-proceed; only accepted completes the V1 construction lifecycle."
    },
    {
      "id": "D-BA-TRACE-001",
      "statement": "Traceability vocabulary 1.5 adds an acceptance horizon and business-acceptance-record node, with forward objective/metric accepted-by and verified-by facts and no inverse edges."
    },
    {
      "id": "D-BA-NO-DEPLOY-001",
      "statement": "Business acceptance records product acceptance only; release, deployment, production verification, monitoring, and operations remain outside V1."
    }
  ],
