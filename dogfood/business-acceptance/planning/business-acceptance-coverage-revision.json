      "id": "D-BA-TECHNICAL-AUTHORITY-002",
      "statement": "SystemVerification remains the sole technical acceptance-criterion authority; BusinessAcceptance validates exact exhaustive upstream coverage and never reruns tests."
    },
    {
      "id": "D-BA-BUSINESS-SCOPE-002",
      "statement": "BusinessAcceptance directly and exhaustively disposes every current in-scope business commitment alongside objectives and success metrics."
    },
    {
      "id": "D-BA-COVERAGE-ARTIFACT-002",
      "statement": "A digest-bound BusinessAcceptanceTechnicalCoverage artifact binds RequirementsBaseline, SystemVerificationResult, TraceabilityGraph checkpoint, every approved criterion, and its passing evidence path."
    },
    {
      "id": "D-BA-TRACEABILITY-SCOPE-002",
      "statement": "Traceability vocabulary 1.5 includes business-scope nodes; trusted requirements and acceptance contributors project only forward approved facts."
    }
