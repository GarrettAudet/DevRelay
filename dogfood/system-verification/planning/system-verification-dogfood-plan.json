{
  "apiVersion": "devrelay.dev/v1alpha1",
  "kind": "SystemVerificationDogfoodPlan",
  "planId": "SV-DOGFOOD-PLAN-001",
  "goal": {
    "apiVersion": "devrelay.dev/v1alpha1",
    "kind": "GoalArtifact",
    "goalId": "goal-system-verification-module-v1",
    "objective": "Build a provider-neutral SystemVerification module that deterministically verifies one immutable fully integrated system candidate against approved system-level functional and quality obligations without granting business acceptance.",
    "constraints": [
      "Core owns candidate binding, obligation expansion, policy evaluation, outcome selection, checkpoint replay, and progression.",
      "Verifier adapters may report raw observations and native evidence only.",
      "BusinessAcceptance remains a separate downstream Core Gate.",
      "The V1 slice must be releasable within the active eight-hour completion window."
    ],
    "acceptanceCriteria": [
      "Exact version-pinned inputs produce byte-identical obligations, evaluation, diagnostics, result, and traceability proposal.",
      "Every approved system-level acceptance criterion and applicable non-functional requirement has an explicit satisfied, failed, or missing-evidence disposition.",
      "Only passing policy evaluation may produce verified and permit BusinessAcceptanceGate progression.",
      "Baseline, repository, integration-fact, evidence, adapter, and policy substitution fail closed.",
      "Traceability adds forward factual AcceptanceCriterion to Evidence links only after verified evaluation."
    ]
  },
  "decisions": [
    {
      "id": "D-SV-SUBJECT-001",
      "statement": "The subject is one immutable IntegratedSystemCandidate binding the final RepositorySnapshot, all required IntegratedChangeRecords, authoritative integrated-completion facts, and the complete approved project baselines."
    },
    {
      "id": "D-SV-OBLIGATIONS-001",
      "statement": "Core deterministically expands applicable acceptance criteria and non-functional requirements into a complete SystemVerificationObligationSet; adapters cannot add, remove, or redefine obligations."
    },
    {
      "id": "D-SV-EVIDENCE-001",
      "statement": "Configured verifier adapters return raw observations and native evidence only; Core normalizes evidence and evaluates the version-pinned SystemVerificationPolicy."
    },
    {
      "id": "D-SV-ENVIRONMENT-001",
      "statement": "Verification environment context is explicit and version-pinned as VerificationEnvironmentSnapshot or ApprovedNotApplicable; conversational or ambient environment state is invalid."
    },
    {
      "id": "D-SV-OUTCOMES-001",
      "statement": "Closed outcomes are verified, failed, needs-evidence, baseline-drift, and unable-to-proceed; only verified progresses to BusinessAcceptanceGate."
    },
    {
      "id": "D-SV-BOUNDARY-001",
      "statement": "SystemVerification cannot modify code, integrate changes, deploy software, alter approved scope, or grant business acceptance."
    }
  ],
  "requirementsGate": {
    "outcome": "approved",
    "clarificationRequired": false
  },
