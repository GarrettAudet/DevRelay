            "priorItemDigest": { "$ref": "https://devrelay.dev/contracts/work-breakdown-artifacts.schema.json#/$defs/digest" },
            "workItem": { "$ref": "https://devrelay.dev/contracts/work-breakdown-artifacts.schema.json#/$defs/workItemDraft" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "workItemId", "priorItemDigest", "rationale"],
          "properties": {
            "operation": { "const": "retire" },
