{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-discovery-gate-submission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "ownerApproval", "artifacts"],
  "properties": {
    "apiVersion": { "const": "devrelay.dev/v1alpha1" },
    "kind": { "const": "DesktopDiscoveryGateSubmission" },
    "ownerApproval": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" }
    }
  }
}
