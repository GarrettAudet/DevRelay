{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-work-execution-preparation/v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "submission", "artifacts", "preparationDigest", "dispatchAuthorized"],
  "properties": {
    "kind": { "const": "LocalWorkExecutionPreparation" },
    "submission": { "$ref": "https://devrelay.dev/host/desktop-work-execution-submission/v1" },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation", "workFingerprint", "qualityResolution"],
      "properties": {
        "invocation": { "$ref": "#/$defs/bytes" },
        "workFingerprint": { "$ref": "#/$defs/bytes" },
        "qualityResolution": { "$ref": "#/$defs/bytes" }
      }
    },
    "preparationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "dispatchAuthorized": { "const": false }
  },
  "$defs": {
    "bytes": { "type": "object", "additionalProperties": false, "required": ["ref", "bytesBase64"],
      "properties": { "ref": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" }, "bytesBase64": { "type": "string", "minLength": 1 } } }
  }
}
