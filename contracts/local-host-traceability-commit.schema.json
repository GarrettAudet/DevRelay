{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-traceability-commit/v1",
  "title": "Local host atomic traceability commit journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "updateRef", "expectedHead", "resultKey"],
  "properties": {
    "kind": { "const": "LocalHostTraceabilityCommit" },
    "id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "updateRef": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" },
    "expectedHead": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" },
    "resultKey": { "type": "string", "pattern": "^result:sha256:[a-f0-9]{64}$" }
  }
}
