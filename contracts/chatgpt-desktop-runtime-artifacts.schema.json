{
  "$id": "https://devrelay.dev/artifacts/chatgpt-desktop-runtime/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatGPT Desktop for Windows runtime contracts",
  "oneOf": [
    { "$ref": "#/$defs/capabilityResolution" },
    { "$ref": "#/$defs/installation" },
    { "$ref": "#/$defs/mcpCommands" },
    { "$ref": "#/$defs/runState" },
    { "$ref": "#/$defs/runView" },
    { "$ref": "#/$defs/taskLifecycle" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "windowsPath": { "type": "string", "pattern": "^[A-Za-z]:\\\\(?:[^<>:\"/\\\\|?*\\r\\n]+\\\\)*[^<>:\"/\\\\|?*\\r\\n]*$" },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "digest"],
      "properties": { "artifactId": { "$ref": "#/$defs/id" }, "digest": { "$ref": "#/$defs/digest" }, "mediaType": { "type": "string", "minLength": 1 }, "schema": { "type": "string", "format": "uri" }, "uri": { "type": "string", "format": "uri" } }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": { "code": { "$ref": "#/$defs/id" }, "message": { "type": "string", "minLength": 1 }, "severity": { "enum": ["info", "warning", "error"] }, "relatedArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } } }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "nextAction": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "enum": ["none", "clarification-required", "gate-decision-required", "progression-available", "resume-available", "evidence-available"] }, "moduleId": { "$ref": "#/$defs/id" }, "artifact": { "$ref": "#/$defs/artifactRef" } }
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "interfaceIntentId", "inputs", "outputs"],
      "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "interfaceIntentId": { "type": "string" }, "inputs": { "type": "object" }, "outputs": { "type": "object" } }
    },
    "mcpRequestBase": {
      "type": "object",
      "required": ["operation", "requestId", "runId", "expectedRevision"],
      "properties": { "operation": { "type": "string" }, "requestId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 } }
    },
    "mcpCreate": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "goal", "circuit", "projectOverview", "policy"], "properties": { "operation": { "const": "create-run" }, "requestId": true, "runId": true, "expectedRevision": true, "goal": { "type": "string", "minLength": 1 }, "circuit": { "$ref": "#/$defs/artifactRef" }, "projectOverview": { "$ref": "#/$defs/artifactRef" }, "policy": { "$ref": "#/$defs/artifactRef" } } }] },
    "mcpInspect": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "reportPolicy"], "properties": { "operation": { "const": "inspect-run" }, "requestId": true, "runId": true, "expectedRevision": true, "reportPolicy": { "$ref": "#/$defs/artifactRef" } } }] },
    "mcpClarify": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "checkpoint", "answers"], "properties": { "operation": { "const": "submit-clarification" }, "requestId": true, "runId": true, "expectedRevision": true, "checkpoint": { "$ref": "#/$defs/artifactRef" }, "answers": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["questionId", "answer"], "properties": { "questionId": { "$ref": "#/$defs/id" }, "answer": { "type": "string", "minLength": 1 } } } } } }] },
    "mcpGate": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "gateCandidate", "decision", "approvalEvidence"], "properties": { "operation": { "const": "submit-gate-decision" }, "requestId": true, "runId": true, "expectedRevision": true, "gateCandidate": { "$ref": "#/$defs/artifactRef" }, "decision": { "enum": ["approve", "reject", "request-revision"] }, "approvalEvidence": { "$ref": "#/$defs/artifactRef" } } }] },
    "mcpProgress": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "approvedPredecessor"], "properties": { "operation": { "const": "progress-run" }, "requestId": true, "runId": true, "expectedRevision": true, "approvedPredecessor": { "$ref": "#/$defs/artifactRef" } } }] },
    "mcpResume": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "checkpoint", "checkpointDigest"], "properties": { "operation": { "const": "resume-run" }, "requestId": true, "runId": true, "expectedRevision": true, "checkpoint": { "$ref": "#/$defs/artifactRef" }, "checkpointDigest": { "$ref": "#/$defs/digest" } } }] },
    "mcpEvidence": { "allOf": [{ "$ref": "#/$defs/mcpRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "requestId", "runId", "expectedRevision", "evidenceId"], "properties": { "operation": { "const": "get-evidence" }, "requestId": true, "runId": true, "expectedRevision": true, "evidenceId": { "$ref": "#/$defs/id" } } }] },
    "mcpOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "runId", "revision", "status", "artifacts", "diagnostics", "nextAction"],
      "properties": { "requestId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 0 }, "status": { "enum": ["completed", "clarification-required", "gate-required", "unable-to-proceed", "failed"] }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } }, "gateState": { "enum": ["not-applicable", "pending", "approved", "rejected", "revision-requested"] }, "diagnostics": { "$ref": "#/$defs/diagnostics" }, "nextAction": { "$ref": "#/$defs/nextAction" } }
    },
    "mcpCommands": { "$ref": "#/$defs/envelope", "type": "object", "properties": { "interfaceIntentId": { "const": "IF-DESKTOP-MCP-COMMANDS" }, "inputs": { "oneOf": [{ "$ref": "#/$defs/mcpCreate" }, { "$ref": "#/$defs/mcpInspect" }, { "$ref": "#/$defs/mcpClarify" }, { "$ref": "#/$defs/mcpGate" }, { "$ref": "#/$defs/mcpProgress" }, { "$ref": "#/$defs/mcpResume" }, { "$ref": "#/$defs/mcpEvidence" }] }, "outputs": { "$ref": "#/$defs/mcpOutput" } } },

    "taskRequestBase": { "type": "object", "required": ["operation", "runId", "workItemId", "attemptId", "taskContract"], "properties": { "operation": { "type": "string" }, "runId": { "$ref": "#/$defs/id" }, "workItemId": { "$ref": "#/$defs/id" }, "attemptId": { "$ref": "#/$defs/id" }, "taskContract": { "$ref": "#/$defs/artifactRef" } } },
    "taskStart": { "allOf": [{ "$ref": "#/$defs/taskRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "runId", "workItemId", "attemptId", "taskContract", "workspacePath", "contextBundle", "permissionDemands"], "properties": { "operation": { "const": "start" }, "runId": true, "workItemId": true, "attemptId": true, "taskContract": true, "workspacePath": { "$ref": "#/$defs/windowsPath" }, "contextBundle": { "$ref": "#/$defs/artifactRef" }, "permissionDemands": { "type": "array", "items": { "type": "string", "minLength": 1 } } } }] },
    "taskExisting": { "allOf": [{ "$ref": "#/$defs/taskRequestBase" }, { "type": "object", "unevaluatedProperties": false, "required": ["operation", "runId", "workItemId", "attemptId", "taskContract", "threadId"], "properties": { "operation": { "enum": ["resume", "inspect", "cancel"] }, "runId": true, "workItemId": true, "attemptId": true, "taskContract": true, "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" } } }] },
    "taskOutput": { "type": "object", "additionalProperties": false, "required": ["runId", "workItemId", "attemptId", "threadId", "state", "eventCheckpoint", "diagnostics"], "properties": { "runId": { "$ref": "#/$defs/id" }, "workItemId": { "$ref": "#/$defs/id" }, "attemptId": { "$ref": "#/$defs/id" }, "threadId": { "$ref": "#/$defs/id" }, "turnId": { "$ref": "#/$defs/id" }, "state": { "enum": ["created", "running", "interrupted", "completed", "failed", "cancelled"] }, "eventCheckpoint": { "$ref": "#/$defs/artifactRef" }, "terminalRawHandoff": { "$ref": "#/$defs/artifactRef" }, "diagnostics": { "$ref": "#/$defs/diagnostics" } }, "allOf": [{ "if": { "properties": { "state": { "enum": ["completed", "failed", "cancelled"] } }, "required": ["state"] }, "then": { "properties": { "terminalRawHandoff": true }, "required": ["terminalRawHandoff"] } }] },
    "taskLifecycle": { "$ref": "#/$defs/envelope", "type": "object", "properties": { "interfaceIntentId": { "const": "IF-DESKTOP-TASK-LIFECYCLE" }, "inputs": { "oneOf": [{ "$ref": "#/$defs/taskStart" }, { "$ref": "#/$defs/taskExisting" }] }, "outputs": { "$ref": "#/$defs/taskOutput" } } },

    "runStateRequest": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["operation", "runId", "expectedRevision"], "properties": { "operation": { "const": "load" }, "runId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 } } },
      { "type": "object", "additionalProperties": false, "required": ["operation", "runId", "expectedRevision", "content", "contentDigest"], "properties": { "operation": { "const": "append" }, "runId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "content": { "$ref": "#/$defs/artifactRef" }, "contentDigest": { "$ref": "#/$defs/digest" } } },
      { "type": "object", "additionalProperties": false, "required": ["operation", "runId", "expectedRevision", "checkpointId", "checkpointDigest", "content"], "properties": { "operation": { "const": "checkpoint" }, "runId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "checkpointId": { "$ref": "#/$defs/id" }, "checkpointDigest": { "$ref": "#/$defs/digest" }, "content": { "$ref": "#/$defs/artifactRef" } } },
      { "type": "object", "additionalProperties": false, "required": ["operation", "runId", "expectedRevision", "replacement", "contentDigest"], "properties": { "operation": { "const": "compare-and-swap" }, "runId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "replacement": { "$ref": "#/$defs/artifactRef" }, "contentDigest": { "$ref": "#/$defs/digest" } } }
    ] },
    "runStateOutput": { "type": "object", "additionalProperties": false, "required": ["runId", "revision", "outcome", "replayed", "contentDigest", "diagnostics"], "properties": { "runId": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 0 }, "outcome": { "enum": ["loaded", "committed", "conflict", "corrupt"] }, "replayed": { "type": "boolean" }, "checkpointId": { "$ref": "#/$defs/id" }, "checkpointDigest": { "$ref": "#/$defs/digest" }, "contentDigest": { "$ref": "#/$defs/digest" }, "content": { "$ref": "#/$defs/artifactRef" }, "diagnostics": { "$ref": "#/$defs/diagnostics" } } },
    "runState": { "$ref": "#/$defs/envelope", "type": "object", "properties": { "interfaceIntentId": { "const": "IF-DESKTOP-RUN-STATE" }, "inputs": { "$ref": "#/$defs/runStateRequest" }, "outputs": { "$ref": "#/$defs/runStateOutput" } }, "allOf": [ { "if": { "properties": { "inputs": { "type": "object", "properties": { "operation": { "const": "load" } }, "required": ["operation"] } }, "required": ["inputs"] }, "then": { "properties": { "outputs": { "type": "object", "properties": { "outcome": { "const": "loaded" } }, "required": ["outcome"] } } } }, { "if": { "properties": { "inputs": { "type": "object", "properties": { "operation": { "enum": ["append", "checkpoint", "compare-and-swap"] } }, "required": ["operation"] } }, "required": ["inputs"] }, "then": { "properties": { "outputs": { "type": "object", "properties": { "outcome": { "enum": ["committed", "conflict", "corrupt"] } }, "required": ["outcome"] } } } } ] },

    "hostFacts": { "type": "object", "additionalProperties": false, "required": ["platform", "architecture", "chatGptDesktopVersion", "codexVersion", "nodeVersion"], "properties": { "platform": { "const": "win32" }, "architecture": { "enum": ["x64", "arm64"] }, "chatGptDesktopVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }, "codexVersion": { "type": "string", "minLength": 1 }, "nodeVersion": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$" } } },
    "capabilityInput": { "type": "object", "additionalProperties": false, "required": ["host", "circuit", "modules", "adapters", "policy", "requiredCapabilities"], "properties": { "host": { "$ref": "#/$defs/hostFacts" }, "circuit": { "$ref": "#/$defs/artifactRef" }, "modules": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } }, "adapters": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } }, "policy": { "$ref": "#/$defs/artifactRef" }, "requiredCapabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "binding": { "type": "object", "additionalProperties": false, "required": ["capability", "module", "adapter", "maturity"], "properties": { "capability": { "$ref": "#/$defs/id" }, "module": { "$ref": "#/$defs/artifactRef" }, "adapter": { "$ref": "#/$defs/artifactRef" }, "maturity": { "const": "release-ready" } } },
    "missingCapability": { "type": "object", "additionalProperties": false, "required": ["capability", "code", "message", "observedMaturity"], "properties": { "capability": { "$ref": "#/$defs/id" }, "code": { "const": "missing-live-capability" }, "message": { "type": "string", "minLength": 1 }, "observedMaturity": { "enum": ["absent", "fixture-only", "experimental", "deprecated"] } } },
    "capabilityOutput": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["outcome", "resolutionDigest", "bindings"], "properties": { "outcome": { "const": "resolved" }, "resolutionDigest": { "$ref": "#/$defs/digest" }, "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } } } }, { "type": "object", "additionalProperties": false, "required": ["outcome", "resolutionDigest", "missing"], "properties": { "outcome": { "const": "blocked" }, "resolutionDigest": { "$ref": "#/$defs/digest" }, "missing": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/missingCapability" } } } } ] },
    "capabilityResolution": { "$ref": "#/$defs/envelope", "type": "object", "properties": { "interfaceIntentId": { "const": "IF-DESKTOP-CAPABILITY-RESOLUTION" }, "inputs": { "$ref": "#/$defs/capabilityInput" }, "outputs": { "$ref": "#/$defs/capabilityOutput" } } },

    "installationInput": { "type": "object", "additionalProperties": false, "required": ["operation", "repository", "repositoryRevision", "repositoryContentDigest", "pluginManifestDigest", "target"], "properties": { "operation": { "enum": ["install", "upgrade", "rollback", "uninstall", "diagnose"] }, "repository": { "type": "string", "format": "uri" }, "repositoryRevision": { "$ref": "#/$defs/gitCommit" }, "repositoryContentDigest": { "$ref": "#/$defs/digest" }, "pluginManifestDigest": { "$ref": "#/$defs/digest" }, "target": { "type": "object", "additionalProperties": false, "required": ["platform", "chatGptDesktopVersion", "pluginPath", "marketplacePath"], "properties": { "platform": { "const": "win32" }, "chatGptDesktopVersion": { "type": "string", "minLength": 1 }, "pluginPath": { "$ref": "#/$defs/windowsPath" }, "marketplacePath": { "$ref": "#/$defs/windowsPath" } } }, "priorInstallation": { "$ref": "#/$defs/artifactRef" }, "rollbackReceipt": { "$ref": "#/$defs/artifactRef" } }, "allOf": [ { "if": { "properties": { "operation": { "enum": ["upgrade", "uninstall"] } }, "required": ["operation"] }, "then": { "properties": { "priorInstallation": true }, "required": ["priorInstallation"] } }, { "if": { "properties": { "operation": { "const": "rollback" } }, "required": ["operation"] }, "then": { "properties": { "priorInstallation": true, "rollbackReceipt": true }, "required": ["priorInstallation", "rollbackReceipt"] } } ] },
    "installedFile": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "$ref": "#/$defs/windowsPath" }, "digest": { "$ref": "#/$defs/digest" } } },
    "installationOutput": { "type": "object", "additionalProperties": false, "required": ["receiptId", "operation", "state", "repositoryRevision", "repositoryContentDigest", "pluginManifestDigest", "installedFiles", "diagnostics"], "properties": { "receiptId": { "$ref": "#/$defs/id" }, "operation": { "enum": ["install", "upgrade", "rollback", "uninstall", "diagnose"] }, "state": { "enum": ["installed", "upgraded", "rolled-back", "uninstalled", "healthy", "drifted", "failed"] }, "repositoryRevision": { "$ref": "#/$defs/gitCommit" }, "repositoryContentDigest": { "$ref": "#/$defs/digest" }, "pluginManifestDigest": { "$ref": "#/$defs/digest" }, "installedFiles": { "type": "array", "items": { "$ref": "#/$defs/installedFile" } }, "priorInstallation": { "$ref": "#/$defs/artifactRef" }, "rollbackReceipt": { "$ref": "#/$defs/artifactRef" }, "diagnostics": { "$ref": "#/$defs/diagnostics" } } },
    "installation": { "$ref": "#/$defs/envelope", "type": "object", "properties": { "interfaceIntentId": { "const": "IF-DESKTOP-INSTALLATION" }, "inputs": { "$ref": "#/$defs/installationInput" }, "outputs": { "$ref": "#/$defs/installationOutput" } } },

    "observation": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "enum": ["available", "unavailable"] }, "value": {}, "reason": { "type": "string", "minLength": 1 }, "source": { "$ref": "#/$defs/artifactRef" } }, "allOf": [ { "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] }, "then": { "properties": { "value": true, "source": true }, "required": ["value", "source"] } }, { "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] }, "then": { "properties": { "reason": true }, "required": ["reason"] } } ] },
    "runViewInput": { "type": "object", "additionalProperties": false, "required": ["runId", "expectedRevision", "reportPolicy", "ledgerCheckpoint"], "properties": { "runId": { "$ref": "#/$defs/id" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "reportPolicy": { "$ref": "#/$defs/artifactRef" }, "ledgerCheckpoint": { "$ref": "#/$defs/artifactRef" } } },
    "runViewOutput": { "type": "object", "additionalProperties": false, "required": ["runId", "revision", "markdown", "report", "checkpoint", "activeStage", "gate", "frontier", "tasks", "evidence", "traceability", "performance"], "properties": { "runId": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 0 }, "markdown": { "type": "string" }, "report": { "$ref": "#/$defs/artifactRef" }, "checkpoint": { "$ref": "#/$defs/artifactRef" }, "activeStage": { "$ref": "#/$defs/observation" }, "gate": { "$ref": "#/$defs/observation" }, "frontier": { "$ref": "#/$defs/observation" }, "tasks": { "$ref": "#/$defs/observation" }, "evidence": { "$ref": "#/$defs/observation" }, "traceability": { "$ref": "#/$defs/observation" }, "performance": { "$ref": "#/$defs/observation" } } },
    "runView": { "$ref": "#/$defs/envelope", "type": "object", "properties": { "interfaceIntentId": { "const": "IF-DESKTOP-RUN-VIEW" }, "inputs": { "$ref": "#/$defs/runViewInput" }, "outputs": { "$ref": "#/$defs/runViewOutput" } } }
  }
}
