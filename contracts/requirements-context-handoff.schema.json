{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/requirements-context-handoff/v1",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "priorSnapshotDigest", "gateCommitDigest", "snapshot", "receipt", "files", "invalidatedBindings", "lifecycleComplete", "handoffDigest"],
  "properties": {
    "apiVersion": { "const": "devrelay.dev/v1alpha1" },
    "kind": { "const": "DesktopRequirementsContextHandoff" },
    "priorSnapshotDigest": { "$ref": "#/$defs/digest" },
    "gateCommitDigest": { "$ref": "#/$defs/digest" },
    "handoffDigest": { "$ref": "#/$defs/digest" },
    "snapshot": { "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/sessionSnapshot" },
    "receipt": { "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/sessionReceipt" },
    "files": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "https://devrelay.dev/host/local-requirements-gate-commit/v1#/$defs/artifactBytes" } },
    "invalidatedBindings": { "type": "array", "items": { "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/contextBinding" } },
    "lifecycleComplete": { "const": false }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
