{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/human-orchestration-artifacts.schema.json",
  "title": "DevRelay human orchestration artifacts",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": { "type": "string", "minLength": 1, "maxLength": 512 },
    "HumanOrchestrationSourceBundle": {
      "type": "object",
      "required": ["apiVersion", "kind", "projectId", "orchestrationRun", "taskObservations", "worktreeLeases", "memorySessions", "approvals", "qualityEvidence", "interventionReceipts", "bundleDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "HumanOrchestrationSourceBundle" },
        "projectId": { "$ref": "#/$defs/identity" },
        "orchestrationRun": { "type": "object", "required": ["kind", "version", "state"], "properties": { "kind": { "const": "LocalHostRunState" }, "version": { "type": "integer", "minimum": 0 }, "state": { "type": "object" } }, "additionalProperties": true },
        "taskObservations": { "type": "array", "items": { "type": "object" } },
        "worktreeLeases": { "type": "array", "items": { "type": "object" } },
        "memorySessions": { "type": "array", "items": { "type": "object" } },
        "approvals": { "type": "array", "items": { "type": "object" } },
        "qualityEvidence": { "type": "array", "items": { "type": "object" } },
        "interventionReceipts": { "type": "array", "items": { "type": "object" } },
        "bundleDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "HumanOrchestrationView": {
      "type": "object",
      "required": ["apiVersion", "kind", "projectId", "runId", "planDigest", "stateVersion", "recovery", "frontier", "queue", "tasks", "worktrees", "memory", "approvals", "quality", "interventions", "blockers", "attention", "controls", "authority", "viewDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "HumanOrchestrationView" },
        "projectId": { "$ref": "#/$defs/identity" },
        "runId": { "$ref": "#/$defs/identity" },
        "planDigest": { "$ref": "#/$defs/digest" },
        "stateVersion": { "type": "integer", "minimum": 0 },
        "recovery": { "type": "string" },
        "frontier": { "type": "object", "required": ["workItemIds", "activeCount", "availableSlots", "frontierDigest", "authority"], "properties": { "workItemIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } }, "activeCount": { "type": "integer", "minimum": 0 }, "availableSlots": { "type": "integer", "minimum": 0 }, "frontierDigest": { "$ref": "#/$defs/digest" }, "authority": { "const": "core-derived" } }, "additionalProperties": false },
        "queue": { "type": "array", "items": { "type": "object" } },
        "tasks": { "type": "array", "items": { "type": "object" } },
        "worktrees": { "type": "array", "items": { "type": "object" } },
        "memory": { "type": "array", "items": { "type": "object" } },
        "approvals": { "type": "array", "items": { "type": "object" } },
        "quality": { "type": "object", "required": ["items", "counts"], "properties": { "items": { "type": "array", "items": { "type": "object" } }, "counts": { "type": "object" } }, "additionalProperties": false },
        "interventions": { "type": "array", "items": { "type": "object" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "attention": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "controls": { "type": "array", "items": { "type": "object", "required": ["action", "route", "authority"], "properties": { "action": { "$ref": "#/$defs/identity" }, "route": { "$ref": "#/$defs/identity" }, "authority": { "const": "request-only" } }, "additionalProperties": false } },
        "authority": { "type": "object", "required": ["readOnly", "readiness", "gates", "integration", "memoryPromotion", "graphActivation", "taskMutation"], "properties": { "readOnly": { "const": true }, "readiness": { "const": false }, "gates": { "const": false }, "integration": { "const": false }, "memoryPromotion": { "const": false }, "graphActivation": { "const": false }, "taskMutation": { "const": false } }, "additionalProperties": false },
        "viewDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "HumanInterventionRequest": {
      "type": "object",
      "required": ["apiVersion", "kind", "requestId", "runId", "expectedStateVersion", "snapshotDigest", "requestedBy", "requestedAt", "action", "target", "reason", "payload", "route", "authority", "requestDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "HumanInterventionRequest" },
        "requestId": { "$ref": "#/$defs/identity" },
        "runId": { "$ref": "#/$defs/identity" },
        "expectedStateVersion": { "type": "integer", "minimum": 0 },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "requestedBy": { "$ref": "#/$defs/identity" },
        "requestedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.+-]+Z?$" },
        "action": { "enum": ["message", "pause", "resume", "cancel", "retry", "handoff", "approve", "reject", "reprioritize"] },
        "target": { "type": "object", "required": ["kind", "id"], "properties": { "kind": { "enum": ["run", "task", "work-item", "gate"] }, "id": { "$ref": "#/$defs/identity" } }, "additionalProperties": false },
        "reason": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "route": { "enum": ["desktop-task-adapter", "desktop-orchestrator", "target-gate", "work-dependency-analysis"] },
        "authority": { "const": "request-only" },
        "requestDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "HumanInterventionReceipt": {
      "type": "object",
      "required": ["apiVersion", "kind", "receiptId", "requestId", "requestDigest", "runId", "action", "route", "expectedStateVersion", "observedStateVersion", "outcome", "observation", "replayed", "authority", "receiptDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "HumanInterventionReceipt" },
        "receiptId": { "$ref": "#/$defs/identity" },
        "requestId": { "$ref": "#/$defs/identity" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "runId": { "$ref": "#/$defs/identity" },
        "action": { "$ref": "#/$defs/identity" },
        "route": { "$ref": "#/$defs/identity" },
        "expectedStateVersion": { "type": "integer", "minimum": 0 },
        "observedStateVersion": { "type": "integer", "minimum": 0 },
        "outcome": { "enum": ["dispatched", "rejected-stale", "rejected-unsupported", "failed"] },
        "observation": { "type": "object" },
        "replayed": { "type": "boolean" },
        "authority": { "const": "observation-only" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/HumanOrchestrationSourceBundle" },
    { "$ref": "#/$defs/HumanOrchestrationView" },
    { "$ref": "#/$defs/HumanInterventionRequest" },
    { "$ref": "#/$defs/HumanInterventionReceipt" }
  ]
}
