{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/contract-generation-artifacts.schema.json",
  "title": "DevRelay ContractGeneration artifacts",
  "oneOf": [
    { "$ref": "#/$defs/projectState" },
    { "$ref": "#/$defs/generatorRequest" },
    { "$ref": "#/$defs/generatedBundle" },
    { "$ref": "#/$defs/validationSet" },
    { "$ref": "#/$defs/diff" },
    { "$ref": "#/$defs/draftSet" },
    { "$ref": "#/$defs/changeSet" },
    { "$ref": "#/$defs/baseline" }
  ],
  "$defs": {
    "apiVersion": { "const": "devrelay.dev/v1alpha1" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "schema", "mediaType", "digest", "uri"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "format": "uri" },
        "mediaType": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "uri": { "type": "string", "format": "uri" }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifactRef" },
        "jsonPointer": { "type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)$" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "semanticInputs", "semanticOutputs", "sourceRequirementIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "semanticInputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "semanticOutputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceRequirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contractEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interfaceIntentId", "contractKind", "artifact", "contentDigest", "compatibility"],
      "properties": {
        "id": { "type": "string", "pattern": "^CT-[A-Z0-9-]+$" },
        "interfaceIntentId": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" },
        "contractKind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "artifact": { "$ref": "#/$defs/artifactRef" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "compatibility": { "enum": ["initial", "backward-compatible", "breaking", "not-applicable"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "subject", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "subject": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "projectState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "stateId", "state", "architectureBaseline", "projectOverviewBaseline", "requiredInterfaceIntentIds"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "ProjectContractState" },
        "stateId": { "type": "string", "pattern": "^PCS-[A-Z0-9-]+$" },
        "state": { "enum": ["not-applicable", "unbaselined", "baselined"] },
        "architectureBaseline": { "$ref": "#/$defs/artifactRef" },
        "projectOverviewBaseline": { "$ref": "#/$defs/artifactRef" },
        "contractBaseline": { "$ref": "#/$defs/artifactRef" },
        "requiredInterfaceIntentIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" } }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "baselined" } }, "required": ["state"] },
          "then": { "required": ["contractBaseline"], "properties": { "contractBaseline": {}, "requiredInterfaceIntentIds": { "type": "array", "minItems": 1 } } },
          "else": { "not": { "required": ["contractBaseline"] } }
        },
        {
          "if": { "properties": { "state": { "const": "not-applicable" } }, "required": ["state"] },
          "then": { "properties": { "requiredInterfaceIntentIds": { "type": "array", "maxItems": 0 } } },
          "else": { "properties": { "requiredInterfaceIntentIds": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "generatorRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "requestId", "operation", "contractKind", "interfaceIntents", "inputBindings"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "ContractGeneratorRequest" },
        "requestId": { "type": "string", "pattern": "^CGR-[A-Z0-9-]+$" },
        "operation": { "enum": ["establish-contracts", "generate-contract-change"] },
        "contractKind": { "type": "string", "minLength": 1 },
        "interfaceIntents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/intent" } },
        "inputBindings": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/inputBinding" } },
        "currentContractBaseline": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "generatedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interfaceIntentId", "contractKind", "schema", "mediaType", "bytesBase64"],
      "properties": {
        "id": { "type": "string", "pattern": "^CT-[A-Z0-9-]+$" },
        "interfaceIntentId": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" },
        "contractKind": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "format": "uri" },
        "mediaType": { "type": "string", "minLength": 1 },
        "bytesBase64": { "type": "string", "minLength": 4 }
      }
    },
    "generatedBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "bundleId", "requestId", "producer", "entries", "diagnostics"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "GeneratedContractBundle" },
        "bundleId": { "type": "string", "pattern": "^GCB-[A-Z0-9-]+$" },
        "requestId": { "type": "string", "pattern": "^CGR-[A-Z0-9-]+$" },
        "producer": { "$ref": "#/$defs/producer" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/generatedEntry" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "interfaceIntentId", "contractKind", "artifact", "validator", "status", "diagnostics"],
      "properties": {
        "contractId": { "type": "string", "pattern": "^CT-[A-Z0-9-]+$" },
        "interfaceIntentId": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" },
        "contractKind": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/artifactRef" },
        "validator": { "$ref": "#/$defs/producer" },
        "status": { "enum": ["pass", "fail"] },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "validationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "validationSetId", "registryDigest", "results", "status"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "ContractFormatValidationSet" },
        "validationSetId": { "type": "string", "pattern": "^CFVS-[A-Z0-9-]+$" },
        "registryDigest": { "$ref": "#/$defs/digest" },
        "results": { "type": "array", "items": { "$ref": "#/$defs/validationResult" } },
        "status": { "enum": ["pass", "fail"] }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractId", "interfaceIntentId", "changeType", "targetDigest", "compatibility"],
      "properties": {
        "contractId": { "type": "string", "pattern": "^CT-[A-Z0-9-]+$" },
        "interfaceIntentId": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" },
        "changeType": { "enum": ["add", "modify", "remove", "unchanged"] },
        "expectedPriorDigest": { "$ref": "#/$defs/digest" },
        "targetDigest": { "$ref": "#/$defs/digest" },
        "compatibility": { "enum": ["initial", "backward-compatible", "breaking", "not-applicable"] }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "diffId", "operation", "changes", "resultingContractsDigest", "status"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "ContractCanonicalDiff" },
        "diffId": { "type": "string", "pattern": "^CCD-[A-Z0-9-]+$" },
        "operation": { "enum": ["establish-contracts", "generate-contract-change"] },
        "currentContractBaseline": { "$ref": "#/$defs/artifactRef" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "resultingContractsDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["compatible", "breaking", "invalid"] }
      }
    },
    "draftBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "operation", "inputBindings", "requiredInterfaceIntentIds", "contracts", "formatValidation", "canonicalDiff", "nativeArtifacts", "sourceRefs"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "enum": ["ContractDraftSet", "ContractChangeSetDraft"] },
        "draftSetId": { "type": "string", "pattern": "^CDS-[A-Z0-9-]+$" },
        "changeSetId": { "type": "string", "pattern": "^CCS-[A-Z0-9-]+$" },
        "operation": { "enum": ["establish-contracts", "generate-contract-change"] },
        "inputBindings": { "type": "array", "items": { "$ref": "#/$defs/inputBinding" } },
        "requiredInterfaceIntentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^IF-[A-Z0-9-]+$" } },
        "contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contractEntry" } },
        "formatValidation": { "$ref": "#/$defs/artifactRef" },
        "canonicalDiff": { "$ref": "#/$defs/artifactRef" },
        "currentContractBaseline": { "$ref": "#/$defs/artifactRef" },
        "nativeArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "draftSet": {
      "allOf": [
        { "$ref": "#/$defs/draftBase" },
        {
          "type": "object",
          "required": ["kind", "draftSetId"],
          "properties": {
            "kind": { "const": "ContractDraftSet" },
            "draftSetId": { "type": "string", "pattern": "^CDS-[A-Z0-9-]+$" },
            "operation": { "const": "establish-contracts" }
          }
        }
      ]
    },
    "changeSet": {
      "allOf": [
        { "$ref": "#/$defs/draftBase" },
        {
          "type": "object",
          "required": ["kind", "changeSetId", "currentContractBaseline"],
          "properties": {
            "kind": { "const": "ContractChangeSetDraft" },
            "changeSetId": { "type": "string", "pattern": "^CCS-[A-Z0-9-]+$" },
            "operation": { "const": "generate-contract-change" },
            "currentContractBaseline": { "$ref": "#/$defs/artifactRef" }
          }
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "baselineId", "version", "approvedCandidate", "architectureBaseline", "projectOverviewBaseline", "contracts", "contractsDigest", "approvalEvidence", "sourceRefs"],
      "properties": {
        "apiVersion": { "$ref": "#/$defs/apiVersion" },
        "kind": { "const": "ContractBaseline" },
        "baselineId": { "type": "string", "pattern": "^CB-[A-Z0-9-]+$" },
        "version": { "$ref": "#/$defs/semver" },
        "approvedCandidate": { "$ref": "#/$defs/artifactRef" },
        "supersedes": { "$ref": "#/$defs/artifactRef" },
        "architectureBaseline": { "$ref": "#/$defs/artifactRef" },
        "projectOverviewBaseline": { "$ref": "#/$defs/artifactRef" },
        "contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contractEntry" } },
        "contractsDigest": { "$ref": "#/$defs/digest" },
        "approvalEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactRef" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    }
  }
}
