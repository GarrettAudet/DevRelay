{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://devrelay.dev/contracts/work-execution-artifacts.schema.json","title":"DevRelay WorkExecution artifacts",
  "oneOf":[{"$ref":"#/$defs/frontier"},{"$ref":"#/$defs/completions"},{"$ref":"#/$defs/policy"},{"$ref":"#/$defs/binding"},{"$ref":"#/$defs/invocation"},{"$ref":"#/$defs/rawResult"},{"$ref":"#/$defs/attempt"},{"$ref":"#/$defs/changeSet"},{"$ref":"#/$defs/evidenceBundle"},{"$ref":"#/$defs/diagnostic"},{"$ref":"#/$defs/retry"},{"$ref":"#/$defs/traceability"}],
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"id":{"type":"string","minLength":1,"maxLength":256},
    "ref":{"type":"object","additionalProperties":false,"required":["artifactId","digest"],"properties":{"artifactId":{"$ref":"#/$defs/id"},"digest":{"$ref":"#/$defs/digest"},"schema":{"type":"string","format":"uri"},"mediaType":{"type":"string","minLength":1},"uri":{"type":"string","format":"uri"}}},
    "bindingRef":{"type":"object","additionalProperties":false,"required":["name","artifact"],"properties":{"name":{"$ref":"#/$defs/id"},"artifact":{"$ref":"#/$defs/ref"}}},
    "executor":{"type":"object","additionalProperties":false,"required":["id","version"],"properties":{"id":{"$ref":"#/$defs/id"},"version":{"type":"string","minLength":1}}},
    "permission":{"type":"object","additionalProperties":false,"required":["kind","scope"],"properties":{"kind":{"enum":["filesystem.read","filesystem.write","network.connect","process.spawn","secrets.read"]},"scope":{"type":"object","additionalProperties":false,"required":["values"],"properties":{"values":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":4096}}}}}},
    "completion":{"type":"object","additionalProperties":false,"required":["workItemId","authority","integrationRef","evidence"],"properties":{"workItemId":{"type":"string","pattern":"^WI-[A-Z0-9-]+$"},"authority":{"const":"approved"},"integrationRef":{"$ref":"#/$defs/ref"},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}}}},
    "frontier":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","workItemId","workBreakdownBaseline","workDependencyBaseline","dependencyGraphDigest","prerequisiteCompletionFacts","readinessDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"RunnableFrontierProof"},"workItemId":{"type":"string","pattern":"^WI-[A-Z0-9-]+$"},"workBreakdownBaseline":{"$ref":"#/$defs/ref"},"workDependencyBaseline":{"$ref":"#/$defs/ref"},"dependencyGraphDigest":{"$ref":"#/$defs/digest"},"prerequisiteCompletionFacts":{"type":"array","items":{"$ref":"#/$defs/completion"}},"readinessDigest":{"$ref":"#/$defs/digest"}}},
    "completions":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","facts","factsDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"IntegratedCompletionFactSet"},"facts":{"type":"array","items":{"$ref":"#/$defs/completion"}},"factsDigest":{"$ref":"#/$defs/digest"}}},
    "policy":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","policyId","version","timeoutMilliseconds","allowedPermissions","outputPolicy","policyDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutionPolicy"},"policyId":{"$ref":"#/$defs/id"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"timeoutMilliseconds":{"type":"integer","minimum":1},"allowedPermissions":{"type":"array","items":{"$ref":"#/$defs/permission"}},"outputPolicy":{"type":"object","additionalProperties":false,"required":["maxEvidenceBytes","maxNativeArtifactBytes"],"properties":{"maxEvidenceBytes":{"type":"integer","minimum":0},"maxNativeArtifactBytes":{"type":"integer","minimum":0}}},"policyDigest":{"$ref":"#/$defs/digest"}}},
    "binding":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","bindingId","workItemId","specialistProfileId","assignmentBaseline","executor","requiredCapabilities","requiredTools","permissionDemands","executionPolicy","configurationDigest","bindingDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutionBinding"},"bindingId":{"$ref":"#/$defs/id"},"workItemId":{"type":"string","pattern":"^WI-[A-Z0-9-]+$"},"specialistProfileId":{"$ref":"#/$defs/id"},"assignmentBaseline":{"$ref":"#/$defs/ref"},"executor":{"$ref":"#/$defs/executor"},"requiredCapabilities":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^CAP-[A-Z0-9-]+$"}},"requiredTools":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^TOOL-[A-Z0-9-]+$"}},"permissionDemands":{"type":"array","items":{"$ref":"#/$defs/permission"}},"executionPolicy":{"$ref":"#/$defs/ref"},"configurationDigest":{"$ref":"#/$defs/digest"},"bindingDigest":{"$ref":"#/$defs/digest"}}},
    "retry":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","predecessorAttempt","reason","retryDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"RetryLineage"},"attemptId":{"$ref":"#/$defs/id"},"predecessorAttempt":{"$ref":"#/$defs/ref"},"reason":{"enum":["failure","interruption","review-fix"]},"retryDigest":{"$ref":"#/$defs/digest"}}},
    "invocation":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","workItem","authoritativeInputs","readinessProof","executionBinding","executionPolicy","projectOverviewBaseline","repositorySnapshot","workspaceBaseDigest","invocationFingerprint"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutorInvocation"},"attemptId":{"$ref":"#/$defs/id"},"workItem":{"$ref":"https://devrelay.dev/contracts/work-breakdown-artifacts.schema.json#/$defs/workItemDraft"},"authoritativeInputs":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/bindingRef"}},"readinessProof":{"$ref":"#/$defs/ref"},"executionBinding":{"$ref":"#/$defs/ref"},"executionPolicy":{"$ref":"#/$defs/ref"},"projectOverviewBaseline":{"$ref":"#/$defs/ref"},"repositorySnapshot":{"$ref":"#/$defs/ref"},"retryLineage":{"$ref":"#/$defs/ref"},"workspaceBaseDigest":{"$ref":"#/$defs/digest"},"invocationFingerprint":{"$ref":"#/$defs/digest"}}},
    "mutation":{"type":"object","additionalProperties":false,"required":["operation","path","beforeDigest","afterDigest"],"properties":{"operation":{"enum":["create","modify","delete"]},"path":{"type":"string","minLength":1,"pattern":"^(?![A-Za-z]:[\\\\/])(?![\\\\/]{1,2})(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},"beforeDigest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]},"afterDigest":{"oneOf":[{"$ref":"#/$defs/digest"},{"type":"null"}]}},"allOf":[{"if":{"properties":{"operation":{"const":"create"}},"required":["operation"]},"then":{"properties":{"beforeDigest":{"type":"null"},"afterDigest":{"$ref":"#/$defs/digest"}}}},{"if":{"properties":{"operation":{"const":"modify"}},"required":["operation"]},"then":{"properties":{"beforeDigest":{"$ref":"#/$defs/digest"},"afterDigest":{"$ref":"#/$defs/digest"}}}},{"if":{"properties":{"operation":{"const":"delete"}},"required":["operation"]},"then":{"properties":{"beforeDigest":{"$ref":"#/$defs/digest"},"afterDigest":{"type":"null"}}}}]},
    "rawResult":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","invocationFingerprint","bindingDigest","executor","terminalState","mutations","evidence","diagnostics","nativeArtifacts"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"RawExecutorResult"},"attemptId":{"$ref":"#/$defs/id"},"invocationFingerprint":{"$ref":"#/$defs/digest"},"bindingDigest":{"$ref":"#/$defs/digest"},"executor":{"$ref":"#/$defs/executor"},"terminalState":{"enum":["proposed","failed","interrupted","unable-to-proceed"]},"mutations":{"type":"array","items":{"$ref":"#/$defs/mutation"}},"evidence":{"type":"array","items":{"$ref":"#/$defs/ref"}},"diagnostics":{"type":"array","items":{"$ref":"#/$defs/ref"}},"nativeArtifacts":{"type":"array","items":{"$ref":"#/$defs/ref"}}}},
    "attempt":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","workItemId","invocationFingerprint","bindingDigest","result","status","attemptDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutionAttempt"},"attemptId":{"$ref":"#/$defs/id"},"workItemId":{"type":"string","pattern":"^WI-[A-Z0-9-]+$"},"invocationFingerprint":{"$ref":"#/$defs/digest"},"bindingDigest":{"$ref":"#/$defs/digest"},"result":{"$ref":"#/$defs/ref"},"status":{"enum":["proposed","failed","interrupted","unable-to-proceed"]},"predecessorAttempt":{"$ref":"#/$defs/ref"},"attemptDigest":{"$ref":"#/$defs/digest"}}},
    "changeSet":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","mutations","changeDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ChangeSetDraft"},"attemptId":{"$ref":"#/$defs/id"},"mutations":{"type":"array","items":{"$ref":"#/$defs/mutation"}},"changeDigest":{"$ref":"#/$defs/digest"}}},
    "evidenceBundle":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","evidence","evidenceDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutionEvidenceBundle"},"attemptId":{"$ref":"#/$defs/id"},"evidence":{"type":"array","items":{"$ref":"#/$defs/ref"}},"evidenceDigest":{"$ref":"#/$defs/digest"}}},
    "diagnostic":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attemptId","code","severity","message"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutionDiagnostic"},"attemptId":{"$ref":"#/$defs/id"},"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},"severity":{"enum":["info","warning","error"]},"message":{"type":"string","minLength":1}}},
    "traceability":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","attempt","workItemId","authority","scope","traceabilityDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ExecutionTraceabilityCandidate"},"attempt":{"$ref":"#/$defs/ref"},"workItemId":{"type":"string","pattern":"^WI-[A-Z0-9-]+$"},"authority":{"const":"candidate"},"scope":{"const":"work-execution/attempt"},"traceabilityDigest":{"$ref":"#/$defs/digest"}}}
  }
}
