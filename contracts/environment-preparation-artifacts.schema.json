{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/environment-preparation-artifacts.schema.json",
  "title": "DevRelay EnvironmentPreparation artifacts",
  "oneOf": [
    { "$ref": "#/$defs/profileSet" },
    { "$ref": "#/$defs/inventory" },
    { "$ref": "#/$defs/remediationPlan" },
    { "$ref": "#/$defs/effectReceipt" },
    { "$ref": "#/$defs/verificationCandidate" },
    { "$ref": "#/$defs/readinessReceipt" },
    { "$ref": "#/$defs/baseline" },
    { "$ref": "#/$defs/gateApproval" },
    { "$ref": "#/$defs/promotionProof" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "schema", "mediaType", "digest", "uri"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "schema": { "type": "string", "format": "uri" },
        "mediaType": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "uri": { "type": "string", "format": "uri" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "artifact": { "$ref": "#/$defs/ref" },
        "jsonPointer": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "checkId": { "$ref": "#/$defs/id" }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "purpose"],
      "properties": {
        "kind": { "enum": ["filesystem.read", "filesystem.write", "network.connect", "process.spawn", "secrets.read"] },
        "scope": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "checkDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "required", "observationKind", "freshnessSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capability": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "observationKind": { "enum": ["os", "architecture", "shell", "runtime", "package-manager", "sdk", "tool", "service", "environment-variable", "filesystem", "attestation"] },
        "constraint": { "type": "string", "minLength": 1 },
        "freshnessSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "name", "checks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "enum": ["devrelay-host", "project-target"] },
        "name": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkDefinition" } }
      }
    },
    "profileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "profileSetId", "version", "repository", "profiles", "sourceRefs", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentProfileSet" },
        "profileSetId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "repository": { "$ref": "#/$defs/ref" },
        "profiles": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/profile" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "sensitivity", "observedAt", "commandFingerprint", "durationMs"],
      "properties": {
        "checkId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "fail", "unknown", "not-applicable"] },
        "sensitivity": { "enum": ["public", "secret-presence"] },
        "value": { "type": ["string", "number", "boolean"] },
        "present": { "type": "boolean" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "commandFingerprint": { "$ref": "#/$defs/digest" },
        "durationMs": { "type": "number", "minimum": 0 },
        "rawEvidence": { "$ref": "#/$defs/ref" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "inventoryId", "profileSet", "repository", "adapter", "observations", "diagnostics", "fingerprint", "sourceRefs", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentInventory" },
        "inventoryId": { "$ref": "#/$defs/id" },
        "profileSet": { "$ref": "#/$defs/ref" },
        "repository": { "$ref": "#/$defs/ref" },
        "adapter": { "type": "object", "additionalProperties": false, "required": ["id", "version", "maturity"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "maturity": { "enum": ["contract-defined", "fixture-conformant", "live-conformant", "release-ready"] } } },
        "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "scope", "description", "impact", "grants", "rollback", "idempotencyKey", "requiredEvidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "capability": { "enum": ["acquire", "configure", "service-check", "target-probe"] },
        "scope": { "enum": ["project-local", "machine-global"] },
        "description": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } },
        "rollback": { "type": "object", "additionalProperties": false, "required": ["supported", "procedure"], "properties": { "supported": { "type": "boolean" }, "procedure": { "type": "string" } } },
        "idempotencyKey": { "$ref": "#/$defs/digest" },
        "requiredEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "remediationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "planId", "profileSet", "inventory", "baseFingerprint", "effects", "approvalRequired", "diagnostics", "sourceRefs", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentRemediationPlan" },
        "planId": { "$ref": "#/$defs/id" },
        "profileSet": { "$ref": "#/$defs/ref" },
        "inventory": { "$ref": "#/$defs/ref" },
        "baseFingerprint": { "$ref": "#/$defs/digest" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "approvalRequired": { "type": "boolean" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "effectReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "receiptId", "plan", "effectId", "adapter", "outcome", "beforeFingerprint", "afterFingerprint", "checkpointKey", "replayed", "durationMs", "grants", "rollbackState", "evidence", "diagnostics", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentEffectReceipt" },
        "receiptId": { "$ref": "#/$defs/id" },
        "plan": { "$ref": "#/$defs/ref" },
        "effectId": { "$ref": "#/$defs/id" },
        "adapter": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 } } },
        "outcome": { "enum": ["applied", "failed", "rolled-back", "no-change"] },
        "beforeFingerprint": { "$ref": "#/$defs/digest" },
        "afterFingerprint": { "$ref": "#/$defs/digest" },
        "checkpointKey": { "$ref": "#/$defs/id" },
        "replayed": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0 },
        "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } },
        "rollbackState": { "enum": ["not-required", "available", "completed", "failed"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "required", "status", "evidence"],
      "properties": {
        "checkId": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "status": { "enum": ["pass", "fail", "unknown", "warning", "not-applicable"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "verificationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "candidateId", "operation", "repository", "upstreamBaselines", "profileSet", "inventory", "effectReceipts", "frontierId", "executionAttemptId", "fingerprint", "checks", "proposedOutcome", "diagnostics", "sourceRefs", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentVerificationCandidate" },
        "candidateId": { "$ref": "#/$defs/id" },
        "operation": { "enum": ["establish-environment", "prepare-frontier", "revalidate-frontier", "remediate-drift"] },
        "repository": { "$ref": "#/$defs/ref" },
        "upstreamBaselines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "profileSet": { "$ref": "#/$defs/ref" },
        "inventory": { "$ref": "#/$defs/ref" },
        "effectReceipts": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "frontierId": { "$ref": "#/$defs/id" },
        "executionAttemptId": { "$ref": "#/$defs/id" },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkResult" } },
        "proposedOutcome": { "enum": ["ready", "needs-clarification", "remediation-required", "baseline-drift", "unable-to-proceed"] },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "readinessReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "receiptId", "candidate", "gateApproval", "repository", "profileSet", "frontierId", "workItemIds", "assignmentBaseline", "executionAttemptId", "fingerprint", "issuedAt", "expiresAt", "singleUse", "consumed", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentReadinessReceipt" },
        "receiptId": { "$ref": "#/$defs/id" },
        "candidate": { "$ref": "#/$defs/ref" },
        "gateApproval": { "$ref": "#/$defs/ref" },
        "repository": { "$ref": "#/$defs/ref" },
        "profileSet": { "$ref": "#/$defs/ref" },
        "frontierId": { "$ref": "#/$defs/id" },
        "workItemIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "assignmentBaseline": { "$ref": "#/$defs/ref" },
        "executionAttemptId": { "$ref": "#/$defs/id" },
        "fingerprint": { "$ref": "#/$defs/digest" },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "singleUse": { "const": true },
        "consumed": { "type": "boolean" },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "baselineId", "version", "approvedCandidate", "profileSet", "policyVersion", "hostFingerprint", "targetFingerprints", "approvalEvidence", "sourceRefs", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentBaseline" },
        "baselineId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "approvedCandidate": { "$ref": "#/$defs/ref" },
        "supersedes": { "$ref": "#/$defs/ref" },
        "profileSet": { "$ref": "#/$defs/ref" },
        "policyVersion": { "type": "string", "minLength": 1 },
        "hostFingerprint": { "$ref": "#/$defs/digest" },
        "targetFingerprints": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/digest" } },
        "approvalEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "gateApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "approvalId", "authority", "decision", "candidate", "terminalCheckpointDigest", "policyVersion", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentGateApproval" },
        "approvalId": { "$ref": "#/$defs/id" },
        "authority": { "const": "devrelay-core" },
        "decision": { "enum": ["ready", "needs-clarification", "remediation-required", "baseline-drift", "unable-to-proceed"] },
        "candidate": { "$ref": "#/$defs/ref" },
        "terminalCheckpointDigest": { "$ref": "#/$defs/digest" },
        "policyVersion": { "type": "string", "minLength": 1 },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "promotionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "proofId", "status", "candidate", "approval", "environmentBaseline", "readinessReceipt", "graphCheckpoint", "checkpointDigest", "contentDigest"],
      "properties": {
        "apiVersion": { "const": "devrelay.dev/v1alpha1" },
        "kind": { "const": "EnvironmentGatePromotionProof" },
        "proofId": { "$ref": "#/$defs/id" },
        "status": { "const": "promoted" },
        "candidate": { "$ref": "#/$defs/ref" },
        "approval": { "$ref": "#/$defs/ref" },
        "environmentBaseline": { "$ref": "#/$defs/ref" },
        "readinessReceipt": { "$ref": "#/$defs/ref" },
        "graphCheckpoint": { "$ref": "#/$defs/ref" },
        "checkpointDigest": { "$ref": "#/$defs/digest" },
        "contentDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
