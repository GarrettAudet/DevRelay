{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-work-execution-claim/v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "request", "result", "claimDigest", "dispatchAuthorized"],
  "properties": {
    "kind": { "const": "LocalWorkExecutionClaim" },
    "request": { "$ref": "https://devrelay.dev/host/desktop-work-claim/v1" },
    "result": { "type": "object", "additionalProperties": false, "required": ["lease", "hostVersion", "indexRevision", "indexDigest"],
      "properties": {
        "lease": { "$ref": "https://devrelay.dev/contracts/work-continuity-artifacts.schema.json" },
        "hostVersion": { "type": "integer", "minimum": 1 }, "indexRevision": { "type": "integer", "minimum": 1 },
        "indexDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      } },
    "claimDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "dispatchAuthorized": { "const": false }
  }
}
