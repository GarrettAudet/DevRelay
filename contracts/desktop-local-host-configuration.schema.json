{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-local-configuration/v1",
  "title": "Explicit Desktop-operated local host configuration",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectId", "workspaceRoot", "stateDirectory", "graphId", "taskId", "sessionSnapshot", "memoryManifest", "memorySessionState", "contractSet", "modules", "plugins", "artifacts", "grants"],
  "properties": {
    "apiVersion": { "const": "devrelay.dev/v1alpha1" },
    "kind": { "const": "DesktopLocalHostConfiguration" },
    "projectId": { "type": "string", "minLength": 1 },
    "workspaceRoot": { "type": "string", "minLength": 1 },
    "stateDirectory": { "type": "string", "minLength": 1 },
    "graphId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "sessionSnapshot": { "$ref": "#/$defs/file" },
    "memoryManifest": { "type": "string", "minLength": 1 },
    "memorySessionState": { "$ref": "#/$defs/file" },
    "contractSet": { "enum": ["requirements", "architecture", "architecture-discovery", "work-breakdown", "work-dependency", "specialist-assignment"] },
    "requirementsObserverVersion": { "enum": ["1.0.0", "1.1.0"] },
    "architectureObserverVersion": { "enum": ["1.0.0", "1.1.0"] },
    "traceabilityVocabularyVersion": { "enum": ["1.5.0", "1.9.0"] },
    "assignmentBinding": { "const": { "id": "devrelay.native-specialist-ranker", "version": "1.0.0" } },
    "dependencyBinding": {
      "type": "object", "additionalProperties": false, "required": ["proposer", "reviewer", "entrypoint"],
      "properties": {
        "proposer": { "const": { "id": "native-structured-dependency-proposer", "version": "0.1.0" } },
        "reviewer": { "const": { "id": "devrelay.native-consistency-reviewer", "version": "0.1.0" } },
        "entrypoint": { "const": "devrelay/work_dependency/decision" }
      }
    },
    "contractGenerators": { "type": "array", "minItems": 1, "maxItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["contractKind", "id", "version"],
      "properties": { "contractKind": { "const": "json-schema" }, "id": { "const": "json-schema-contract-generator" }, "version": { "const": "0.1.0" } }
    } },
    "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "plugins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactFile" } },
    "grants": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "values"], "properties": { "kind": { "enum": ["filesystem.read", "filesystem.write"] }, "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } } }
  },
  "$defs": {
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "artifactFile": { "type": "object", "additionalProperties": false, "required": ["path", "ref"], "properties": { "path": { "type": "string", "minLength": 1 }, "ref": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" } } }
  }
}
