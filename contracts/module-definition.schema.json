{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/module-definition.schema.json",
  "title": "DevRelay ModuleDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "operations"
  ],
  "properties": {
    "apiVersion": {
      "const": "devrelay.dev/v1alpha1"
    },
    "kind": {
      "const": "ModuleDefinition"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "routing": {
      "$ref": "#/$defs/routing"
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "inputs",
        "outputs",
        "inputRules",
        "outcomes",
        "resultContracts",
        "evidence",
        "optionsSchema"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "inputRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputRule"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          }
        },
        "resultContracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/resultContract"
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
          }
        },
        "optionsSchema": {
          "type": "object"
        },
        "adapterChain": {
          "$ref": "#/$defs/adapterChain"
        }
      }
    },
    "adapterChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earlyTerminalOutcomes",
        "steps"
      ],
      "properties": {
        "earlyTerminalOutcomes": {
          "$ref": "#/$defs/nameSet"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/adapterChainStep"
          }
        },
        "resume": {
          "$ref": "#/$defs/chainResume"
        }
      }
    },
    "adapterChainStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "handoff",
            "terminal"
          ]
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "handoff"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "outputs": {}
            },
            "required": [
              "outputs"
            ]
          },
          "else": {
            "properties": {
              "outputs": false
            }
          }
        }
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "mediaTypes",
        "cardinality",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^application/(?:json|[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*\\+json)$"
          }
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "inputRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ifPresent",
        "require"
      ],
      "properties": {
        "ifPresent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "require": {
          "$ref": "#/$defs/nameSet"
        }
      }
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requiredInputs",
        "forbiddenInputs",
        "requiredOutputs",
        "allowedOutputs",
        "requiredEvidence",
        "diagnosticsRequired"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "waiting"
          ]
        },
        "requiredInputs": {
          "$ref": "#/$defs/nameSet"
        },
        "forbiddenInputs": {
          "$ref": "#/$defs/nameSet"
        },
        "requiredOutputs": {
          "$ref": "#/$defs/nameSet"
        },
        "allowedOutputs": {
          "$ref": "#/$defs/nameSet"
        },
        "requiredEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "diagnosticsRequired": {
          "type": "boolean"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statuses"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          }
        },
        "artifactOutput": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "nameSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateInput",
        "stateSchema",
        "decisionInput",
        "discriminator",
        "rules"
      ],
      "properties": {
        "stateInput": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "stateSchema": {
          "type": "string",
          "format": "uri"
        },
        "decisionInput": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "discriminator": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^/"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/routingRule"
          }
        }
      }
    },
    "routingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reasonCode"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "prerequisite": {
          "$ref": "#/$defs/routingPrerequisite"
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$",
          "maxLength": 256
        }
      },
      "oneOf": [
        {
          "required": [
            "operation"
          ],
          "properties": {
            "operation": {},
            "prerequisite": false
          }
        },
        {
          "required": [
            "prerequisite"
          ],
          "properties": {
            "operation": false,
            "prerequisite": {}
          }
        }
      ]
    },
    "routingPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "operation",
        "outputSchema"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/routingModuleRef"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "outputSchema": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "routingModuleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "chainResume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuationInput",
        "continuationOutput",
        "chainFingerprintField",
        "activeStepField",
        "completedStepsField",
        "completedStepIdField",
        "completedStepPluginField",
        "completedStepOutputsField",
        "lineageInputs",
        "controlInputs",
        "sourceInvocationField",
        "sourceInvocationIdField",
        "sourceInvocationFingerprintField",
        "completedStepInvocationDigestField",
        "completedStepResultDigestField"
      ],
      "properties": {
        "continuationInput": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "continuationOutput": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "chainFingerprintField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "activeStepField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "completedStepsField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "completedStepIdField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "completedStepPluginField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "completedStepOutputsField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "lineageInputs": {
          "$ref": "#/$defs/nameSet"
        },
        "controlInputs": {
          "$ref": "#/$defs/nameSet"
        },
        "sourceInvocationField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "sourceInvocationIdField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "sourceInvocationFingerprintField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "completedStepInvocationDigestField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "completedStepResultDigestField": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        }
      }
    }
  }
}
