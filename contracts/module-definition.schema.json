{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/module-definition.schema.json",
  "title": "DevRelay ModuleDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "operations"
  ],
  "properties": {
    "apiVersion": {
      "const": "devrelay.dev/v1alpha1"
    },
    "kind": {
      "const": "ModuleDefinition"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "inputs",
        "outputs",
        "inputRules",
        "outcomes",
        "resultContracts",
        "evidence",
        "optionsSchema"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "inputRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputRule"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          }
        },
        "resultContracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/resultContract"
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
          }
        },
        "optionsSchema": {
          "type": "object"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "mediaTypes",
        "cardinality",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "inputRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ifPresent",
        "require"
      ],
      "properties": {
        "ifPresent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "require": {
          "$ref": "#/$defs/nameSet"
        }
      }
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requiredInputs",
        "forbiddenInputs",
        "requiredOutputs",
        "allowedOutputs",
        "requiredEvidence",
        "diagnosticsRequired"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "waiting"
          ]
        },
        "requiredInputs": {
          "$ref": "#/$defs/nameSet"
        },
        "forbiddenInputs": {
          "$ref": "#/$defs/nameSet"
        },
        "requiredOutputs": {
          "$ref": "#/$defs/nameSet"
        },
        "allowedOutputs": {
          "$ref": "#/$defs/nameSet"
        },
        "requiredEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "diagnosticsRequired": {
          "type": "boolean"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statuses"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          }
        },
        "artifactOutput": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "nameSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
      }
    }
  }
}
