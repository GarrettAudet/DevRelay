{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-work-claim/v1",
  "type": "object", "additionalProperties": false,
  "required": ["attemptId", "preparationDigest", "owner", "leaseExpiresAt", "expectedHostVersion", "expectedIndexRevision"],
  "properties": {
    "attemptId": { "type": "string", "minLength": 1 },
    "preparationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "owner": { "type": "string", "minLength": 1 },
    "leaseExpiresAt": { "type": "integer", "minimum": 1 },
    "expectedHostVersion": { "type": "integer", "minimum": 0 },
    "expectedIndexRevision": { "type": "integer", "minimum": 0 }
  }
}
