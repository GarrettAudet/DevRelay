{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://devrelay.dev/contracts/system-verification-artifacts.schema.json","title":"DevRelay SystemVerification artifacts",
  "oneOf":[{"$ref":"#/$defs/subject"},{"$ref":"#/$defs/obligations"},{"$ref":"#/$defs/invocation"},{"$ref":"#/$defs/rawObservation"},{"$ref":"#/$defs/evidence"},{"$ref":"#/$defs/policy"},{"$ref":"#/$defs/evaluation"},{"$ref":"#/$defs/result"}],
