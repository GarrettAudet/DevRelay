    "obligations":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","obligationSetId","subject","obligations","obligationSetDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"SystemVerificationObligationSet"},"obligationSetId":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/ref"},"obligations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/obligation"}},"obligationSetDigest":{"$ref":"#/$defs/digest"}}},
