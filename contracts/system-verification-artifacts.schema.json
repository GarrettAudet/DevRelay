    "rawObservation":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","observationId","invocationFingerprint","subject","obligationSet","verifier","observations","nativeEvidence","rawObservationDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"RawSystemVerifierObservation"},"observationId":{"$ref":"#/$defs/id"},"invocationFingerprint":{"$ref":"#/$defs/digest"},"subject":{"$ref":"#/$defs/ref"},"obligationSet":{"$ref":"#/$defs/ref"},"verifier":{"$ref":"#/$defs/verifier"},"observations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/observation"}},"nativeEvidence":{"type":"array","items":{"$ref":"#/$defs/ref"}},"rawObservationDigest":{"$ref":"#/$defs/digest"}}},
    "evidenceItem":{"type":"object","additionalProperties":false,"required":["evidenceId","obligationId","kind","status","artifact","producer"],"properties":{"evidenceId":{"$ref":"#/$defs/id"},"obligationId":{"$ref":"#/$defs/id"},"kind":{"$ref":"#/$defs/id"},"status":{"enum":["pass","fail","inconclusive"]},"artifact":{"$ref":"#/$defs/ref"},"producer":{"$ref":"#/$defs/verifier"}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","evidenceSetId","subject","obligationSet","rawObservations","items","evidenceDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"NormalizedSystemVerificationEvidence"},"evidenceSetId":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/ref"},"obligationSet":{"$ref":"#/$defs/ref"},"rawObservations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},"items":{"type":"array","items":{"$ref":"#/$defs/evidenceItem"}},"evidenceDigest":{"$ref":"#/$defs/digest"}}},
    "policy":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","policyId","version","allObligationsMandatory","unknownEvidence","outcomePrecedence","policyDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"SystemVerificationPolicy"},"policyId":{"$ref":"#/$defs/id"},"version":{"const":"1.0.0"},"allObligationsMandatory":{"const":true},"unknownEvidence":{"const":"reject"},"outcomePrecedence":{"type":"array","prefixItems":[{"const":"failed"},{"const":"needs-evidence"},{"const":"verified"}],"items":false,"minItems":3,"maxItems":3},"policyDigest":{"$ref":"#/$defs/digest"}}},
    "disposition":{"type":"object","additionalProperties":false,"required":["obligationId","status","evidenceIds"],"properties":{"obligationId":{"$ref":"#/$defs/id"},"status":{"enum":["satisfied","failed","missing-evidence"]},"evidenceIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "evaluation":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","evaluationId","subject","obligationSet","policy","evidence","dispositions","outcome","evaluationDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"SystemVerificationEvaluation"},"evaluationId":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/ref"},"obligationSet":{"$ref":"#/$defs/ref"},"policy":{"$ref":"#/$defs/ref"},"evidence":{"$ref":"#/$defs/ref"},"dispositions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/disposition"}},"outcome":{"enum":["verified","failed","needs-evidence"]},"evaluationDigest":{"$ref":"#/$defs/digest"}}},
    "result":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","resultId","subject","obligationSet","policy","evidence","evaluation","outcome","progression","authority","resultDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"SystemVerificationResult"},"resultId":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/ref"},"obligationSet":{"$ref":"#/$defs/ref"},"policy":{"$ref":"#/$defs/ref"},"evidence":{"$ref":"#/$defs/ref"},"evaluation":{"$ref":"#/$defs/ref"},"outcome":{"enum":["verified","failed","needs-evidence"]},"progression":{"enum":["business-acceptance-gate","none"]},"authority":{"const":"system-verification"},"resultDigest":{"$ref":"#/$defs/digest"}}}
  }
