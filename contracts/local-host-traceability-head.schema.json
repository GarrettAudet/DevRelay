{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-traceability-head/v1",
  "title": "Local host atomic traceability head",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "namespace", "graphId", "headRef"],
  "properties": {
    "kind": { "const": "LocalHostTraceabilityHead" },
