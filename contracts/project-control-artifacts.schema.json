{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/project-control-artifacts.schema.json",
  "title": "DevRelay ProjectControl artifacts",
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "oneOf": [
    { "type": "object", "required": ["apiVersion", "kind", "projectId", "lifecycle", "workItems", "dependencies", "assignments", "taskObservations", "worktreeObservations", "qualityAssessments", "continuityRecords", "verificationResults", "traceabilityDiagnostics", "roadmapRefs", "memoryRefs", "sourceRefs", "bundleDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ProjectControlSourceBundle" }, "projectId": { "type": "string", "minLength": 1 }, "lifecycle": { "type": "object" }, "workItems": { "type": "array" }, "dependencies": { "type": "array" }, "assignments": { "type": "array" }, "taskObservations": { "type": "array" }, "worktreeObservations": { "type": "array" }, "qualityAssessments": { "type": "array" }, "continuityRecords": { "type": "array" }, "verificationResults": { "type": "array" }, "traceabilityDiagnostics": { "type": "array" }, "roadmapRefs": { "type": "array" }, "memoryRefs": { "type": "array" }, "sourceRefs": { "type": "array" }, "bundleDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "measurements"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "BenchmarkMeasurements" }, "measurements": { "type": "array", "items": { "type": "object", "required": ["operation", "durationMilliseconds"], "properties": { "operation": { "type": "string", "minLength": 1 }, "durationMilliseconds": { "type": "number", "minimum": 0 } }, "additionalProperties": false } } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "projectId", "lifecycle", "frontier", "counts", "dependencyHealth", "qualityHealth", "continuity", "observations", "diagnostics", "references", "authority", "snapshotDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ProjectControlSnapshot" }, "projectId": { "type": "string", "minLength": 1 }, "lifecycle": { "type": "object" }, "frontier": { "type": "array", "uniqueItems": true }, "counts": { "type": "object" }, "dependencyHealth": { "type": "object" }, "qualityHealth": { "type": "object" }, "continuity": { "type": "object" }, "observations": { "type": "object" }, "diagnostics": { "type": "array" }, "references": { "type": "object" }, "authority": { "type": "object", "required": ["readOnly", "gates", "readiness", "integration", "memoryPromotion", "graphActivation"], "properties": { "readOnly": { "const": true }, "gates": { "const": false }, "readiness": { "const": false }, "integration": { "const": false }, "memoryPromotion": { "const": false }, "graphActivation": { "const": false } }, "additionalProperties": false }, "snapshotDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "projectControlSnapshotDigest", "sampleCount", "p50Milliseconds", "p95Milliseconds", "measurements", "scope", "universalPerformanceClaim", "assessmentDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ProjectProductivityAssessment" }, "projectControlSnapshotDigest": { "$ref": "#/$defs/digest" }, "sampleCount": { "type": "integer", "minimum": 0 }, "p50Milliseconds": { "type": ["number", "null"] }, "p95Milliseconds": { "type": ["number", "null"] }, "measurements": { "type": "array" }, "scope": { "const": "local-observation-only" }, "universalPerformanceClaim": { "const": false }, "assessmentDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  ]
}
