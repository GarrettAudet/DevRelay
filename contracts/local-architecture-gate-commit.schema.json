{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-architecture-gate-commit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "invocationDigest",
    "moduleResultDigest",
    "candidateRef",
    "ownerApproval",
    "baseline",
    "scope",
    "lifecycleComplete",
    "commitDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "devrelay.dev/v1alpha1"
    },
    "kind": {
      "const": "LocalArchitectureGateCommit"
    },
    "invocationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "moduleResultDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidateRef": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "ownerApproval": {
      "$ref": "https://devrelay.dev/host/local-requirements-gate-commit/v1#/$defs/artifactBytes"
    },
    "baseline": {
      "$ref": "https://devrelay.dev/host/local-requirements-gate-commit/v1#/$defs/artifactBytes"
    },
    "scope": {
      "const": "validated-architecture-baseline"
    },
    "lifecycleComplete": {
      "const": false
    },
    "commitDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
