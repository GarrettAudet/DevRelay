{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-architecture-head/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "state",
    "activationDigest"
  ],
  "properties": {
    "pendingCommit": {
      "description": "Exact owning Gate activation awaiting recovery; omitted on legacy heads.",
      "anyOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "kind": {
      "const": "LocalArchitectureHead"
    },
    "state": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "activationDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
