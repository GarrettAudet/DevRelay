    "verifiedSubject":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","subjectId","workItem","changeSet","verificationGateApproval","verificationEvidence","subjectDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"VerifiedWorkItemSubject"},"subjectId":{"$ref":"#/$defs/id"},"workItem":{"$ref":"#/$defs/ref"},"changeSet":{"$ref":"#/$defs/ref"},"verificationGateApproval":{"$ref":"#/$defs/ref"},"verificationEvidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},"subjectDigest":{"$ref":"#/$defs/digest"}}},
