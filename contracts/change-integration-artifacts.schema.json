    "adapterInvocation":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","invocationId","plan","adapter","permissionDemands","operation","invocationFingerprint"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"IntegrationAdapterInvocation"},"invocationId":{"$ref":"#/$defs/id"},"plan":{"$ref":"#/$defs/ref"},"adapter":{"$ref":"#/$defs/adapter"},"permissionDemands":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/permissionDemand"}},"operation":{"$ref":"#/$defs/operationDetails"},"invocationFingerprint":{"$ref":"#/$defs/digest"}}},
    "rawEffectResult":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","invocationId","invocationFingerprint","adapter","terminalState","effectState","operation","preState","nativeEvidence"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"RawIntegrationEffectResult"},"invocationId":{"$ref":"#/$defs/id"},"invocationFingerprint":{"$ref":"#/$defs/digest"},"adapter":{"$ref":"#/$defs/adapter"},"terminalState":{"enum":["integrated","conflict","failed","interrupted","uncertain"]},"effectState":{"enum":["not-applied","applied","unknown"]},"operation":{"$ref":"#/$defs/operationDetails"},"preState":{"$ref":"#/$defs/observation"},"postState":{"$ref":"#/$defs/observation"},"conflictingPaths":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"pattern":"^(?![A-Za-z]:[\\\\/])(?![\\\\/]{1,2})(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"}},"nativeEvidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}}},"allOf":[{"if":{"properties":{"terminalState":{"const":"integrated"}},"required":["terminalState"]},"then":{"required":["postState"],"properties":{"effectState":{"const":"applied"},"postState":{"$ref":"#/$defs/observation"}}}},{"if":{"properties":{"terminalState":{"const":"conflict"}},"required":["terminalState"]},"then":{"required":["conflictingPaths"],"properties":{"conflictingPaths":{"type":"array","minItems":1}}},"else":{"properties":{"conflictingPaths":false}}}]},
    "conflictSet":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","conflictSetId","subject","plan","target","paths","targetUnchanged","evidence","conflictDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"IntegrationConflictSet"},"conflictSetId":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/ref"},"plan":{"$ref":"#/$defs/ref"},"target":{"$ref":"#/$defs/observation"},"paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"targetUnchanged":{"const":true},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"conflictDigest":{"$ref":"#/$defs/digest"}}},
    "integratedRecord":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","recordId","subject","plan","preState","postState","integrationEvidence","recordDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"IntegratedChangeRecord"},"recordId":{"$ref":"#/$defs/id"},"subject":{"$ref":"#/$defs/ref"},"plan":{"$ref":"#/$defs/ref"},"preState":{"$ref":"#/$defs/observation"},"postState":{"$ref":"#/$defs/observation"},"integrationEvidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"recordDigest":{"$ref":"#/$defs/digest"}}},
    "recoveryEvidence":{"type":"object","additionalProperties":false,"required":["disposition","observedState","observationEvidence"],"properties":{"disposition":{"enum":["applied","not-applied","unresolved"]},"observedState":{"$ref":"#/$defs/observation"},"observationEvidence":{"$ref":"#/$defs/ref"},"producedCommitAuthorization":{"$ref":"#/$defs/ref"}}},
    "checkpoint":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","checkpointId","invocation","operation","state","recoveryStatus","checkpointDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"IntegrationCheckpoint"},"checkpointId":{"$ref":"#/$defs/id"},"invocation":{"$ref":"#/$defs/ref"},"operation":{"$ref":"#/$defs/operationDetails"},"rawResult":{"$ref":"#/$defs/ref"},"recoveryEvidence":{"$ref":"#/$defs/recoveryEvidence"},"state":{"enum":["prepared","effect-recorded","reconciled"]},"recoveryStatus":{"enum":["not-required","pending","recovered","needs-reconciliation"]},"observedState":{"$ref":"#/$defs/observation"},"checkpointDigest":{"$ref":"#/$defs/digest"}},"allOf":[{"if":{"properties":{"state":{"const":"prepared"}},"required":["state"]},"then":{"properties":{"rawResult":false,"recoveryEvidence":false}}},{"if":{"properties":{"state":{"const":"effect-recorded"}},"required":["state"]},"then":{"required":["rawResult"],"properties":{"rawResult":{"$ref":"#/$defs/ref"},"recoveryEvidence":false}}},{"if":{"properties":{"state":{"const":"reconciled"}},"required":["state"]},"then":{"oneOf":[{"required":["rawResult","observedState"],"properties":{"rawResult":{"$ref":"#/$defs/ref"},"observedState":{"$ref":"#/$defs/observation"},"recoveryEvidence":false}},{"required":["recoveryEvidence"],"properties":{"rawResult":false,"observedState":false,"recoveryEvidence":{"$ref":"#/$defs/recoveryEvidence"}}}]}}]},
