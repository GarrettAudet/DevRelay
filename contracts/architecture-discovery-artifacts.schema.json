{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/architecture-discovery-artifacts.schema.json",
  "title": "DevRelay ArchitectureDiscovery artifacts",
  "oneOf": [
    { "$ref": "#/$defs/inventoryInvocation" },
    { "$ref": "#/$defs/nativeInventory" },
    { "$ref": "#/$defs/analyzerInvocation" },
    { "$ref": "#/$defs/analyzerResult" },
    { "$ref": "#/$defs/observation" },
    { "$ref": "#/$defs/gap" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/checkpoint" },
    { "$ref": "#/$defs/traceabilityInput" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]{1,2})(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["artifactId", "digest"], "properties": { "artifactId": { "$ref": "#/$defs/id" }, "digest": { "$ref": "#/$defs/digest" }, "schema": { "type": "string", "format": "uri" }, "mediaType": { "type": "string", "minLength": 1 }, "uri": { "type": "string", "format": "uri" } } },
    "adapter": { "type": "object", "additionalProperties": false, "required": ["id", "version", "configurationDigest"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" }, "configurationDigest": { "$ref": "#/$defs/digest" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["artifact", "location"], "properties": { "artifact": { "$ref": "#/$defs/ref" }, "location": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "path": { "$ref": "#/$defs/path" }, "jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$" } } } } },
    "confidence": { "type": "object", "additionalProperties": false, "required": ["disposition", "score", "rationale"], "properties": { "disposition": { "enum": ["observed", "deterministically-derived", "analyzer-inferred", "unknown", "not-applicable"] }, "score": { "type": "number", "minimum": 0, "maximum": 1 }, "rationale": { "type": "string", "minLength": 1 } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["id", "category", "subject", "statement", "confidence", "method", "adapter", "sources"], "properties": { "id": { "$ref": "#/$defs/id" }, "category": { "enum": ["element", "relationship", "interface", "constraint", "decision-record", "diagram", "model-attachment", "repository-boundary", "language", "manifest", "build", "package"] }, "subject": { "$ref": "#/$defs/id" }, "statement": { "type": "string", "minLength": 1 }, "confidence": { "$ref": "#/$defs/confidence" }, "method": { "enum": ["native-inventory", "specialized-analyzer"] }, "adapter": { "$ref": "#/$defs/adapter" }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } } } },
    "inventoryInvocation": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "repositorySnapshot", "allowedPaths", "policy", "adapter", "invocationFingerprint"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "RepositoryInventoryInvocation" }, "invocationId": { "$ref": "#/$defs/id" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "allowedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }, "policy": { "$ref": "#/$defs/ref" }, "adapter": { "$ref": "#/$defs/adapter" }, "invocationFingerprint": { "$ref": "#/$defs/digest" } } },
    "nativeInventory": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "invocationFingerprint", "repositorySnapshot", "adapter", "status", "findings", "nativeEvidence", "inventoryDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "NativeRepositoryInventory" }, "invocationId": { "$ref": "#/$defs/id" }, "invocationFingerprint": { "$ref": "#/$defs/digest" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "adapter": { "$ref": "#/$defs/adapter" }, "status": { "enum": ["completed", "unable-to-proceed", "failed", "interrupted"] }, "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "nativeEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } }, "inventoryDigest": { "$ref": "#/$defs/digest" } } },
    "analyzerInvocation": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "repositorySnapshot", "nativeInventory", "contextSlice", "adapter", "invocationFingerprint"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ArchitectureAnalyzerInvocation" }, "invocationId": { "$ref": "#/$defs/id" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "nativeInventory": { "$ref": "#/$defs/ref" }, "contextSlice": { "$ref": "#/$defs/ref" }, "adapter": { "$ref": "#/$defs/adapter" }, "invocationFingerprint": { "$ref": "#/$defs/digest" } } },
    "analyzerResult": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "invocationId", "invocationFingerprint", "repositorySnapshot", "nativeInventory", "adapter", "status", "findings", "nativeEvidence", "resultDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ArchitectureAnalyzerResult" }, "invocationId": { "$ref": "#/$defs/id" }, "invocationFingerprint": { "$ref": "#/$defs/digest" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "nativeInventory": { "$ref": "#/$defs/ref" }, "adapter": { "$ref": "#/$defs/adapter" }, "status": { "enum": ["completed", "unavailable", "failed", "interrupted"] }, "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "nativeEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } }, "resultDigest": { "$ref": "#/$defs/digest" } } },
    "observation": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "observationId", "repositorySnapshot", "finding", "observationDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ArchitectureObservation" }, "observationId": { "$ref": "#/$defs/id" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "finding": { "$ref": "#/$defs/finding" }, "observationDigest": { "$ref": "#/$defs/digest" } } },
    "gap": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "gapId", "subject", "material", "reason", "confidence", "sources", "gapDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ArchitectureDiscoveryGap" }, "gapId": { "$ref": "#/$defs/id" }, "subject": { "$ref": "#/$defs/id" }, "material": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 }, "confidence": { "$ref": "#/$defs/confidence" }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }, "gapDigest": { "$ref": "#/$defs/digest" } } },
    "snapshot": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "snapshotId", "repositorySnapshot", "nativeInventory", "analyzerResults", "observations", "gaps", "warnings", "discoveryMethods", "sourceRefs", "authority", "snapshotDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "CurrentArchitectureSnapshot" }, "snapshotId": { "$ref": "#/$defs/id" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "nativeInventory": { "$ref": "#/$defs/ref" }, "analyzerResults": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }, "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } }, "gaps": { "type": "array", "items": { "$ref": "#/$defs/ref" } }, "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "discoveryMethods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["native-inventory", "specialized-analyzer"] } }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }, "authority": { "const": "observational" }, "snapshotDigest": { "$ref": "#/$defs/digest" } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "checkpointId", "invocationId", "invocationFingerprint", "repositorySnapshot", "step", "adapter", "result", "state", "checkpointDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ArchitectureDiscoveryCheckpoint" }, "checkpointId": { "$ref": "#/$defs/id" }, "invocationId": { "$ref": "#/$defs/id" }, "invocationFingerprint": { "$ref": "#/$defs/digest" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "step": { "enum": ["inventory", "analyzer"] }, "adapter": { "$ref": "#/$defs/adapter" }, "result": { "$ref": "#/$defs/ref" }, "state": { "const": "durable" }, "checkpointDigest": { "$ref": "#/$defs/digest" } } },
    "traceabilityInput": { "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "snapshot", "repositorySnapshot", "authority", "scope", "traceabilityDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ArchitectureDiscoveryTraceabilityInput" }, "snapshot": { "$ref": "#/$defs/ref" }, "repositorySnapshot": { "$ref": "#/$defs/ref" }, "authority": { "const": "candidate" }, "scope": { "const": "architecture-discovery/observational" }, "traceabilityDigest": { "$ref": "#/$defs/digest" } } }
  }
}
