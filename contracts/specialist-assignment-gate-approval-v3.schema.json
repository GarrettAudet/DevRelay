{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/evidence/specialist-assignment-gate-approval/v3",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "approvalId", "authority", "decision", "policyVersion", "candidate", "checkpointDigest", "executionFingerprint", "requiredEvidence"],
  "properties": {
    "apiVersion": { "const": "devrelay.dev/v1alpha1" },
    "kind": { "const": "SpecialistAssignmentGateApproval" },
    "approvalId": { "type": "string", "minLength": 1 },
    "authority": { "const": "project-owner" },
    "decision": { "const": "approve" },
    "policyVersion": { "const": "specialist-assignment-gate/3.0.0" },
    "candidate": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" },
    "checkpointDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "executionFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "requiredEvidence": { "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" } }
  }
}
