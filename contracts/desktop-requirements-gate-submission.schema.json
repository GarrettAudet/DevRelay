{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-requirements-gate-submission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "requirementsBaseline", "projectOverviewBaseline", "projectOverviewMarkdown", "approvalEvidence"],
  "properties": {
    "apiVersion": { "const": "devrelay.dev/v1alpha1" },
    "kind": { "const": "DesktopRequirementsGateSubmission" },
    "requirementsBaseline": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" },
    "projectOverviewBaseline": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" },
    "projectOverviewMarkdown": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/file" },
    "approvalEvidence": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" }
    }
  }
}
