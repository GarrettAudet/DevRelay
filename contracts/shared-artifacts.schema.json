{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/shared-artifacts.schema.json",
  "title": "DevRelay shared artifacts",
  "oneOf": [
    {
      "$ref": "https://devrelay.dev/contracts/shared-artifacts.schema.json#/$defs/nativeSourceBundle"
    }
  ],
  "$defs": {
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "digest"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "nativeSourceBundle": {
      "$id": "https://devrelay.dev/artifacts/native-source-bundle/v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "plugin",
        "tool",
        "operation",
        "sources",
        "canonicalOutputs",
        "normalization"
      ],
      "properties": {
        "apiVersion": {
          "const": "devrelay.dev/v1alpha1"
        },
        "kind": {
          "const": "NativeSourceBundle"
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "path",
              "artifact"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "artifact": {
                "$ref": "https://devrelay.dev/contracts/shared-artifacts.schema.json#/$defs/artifactPointer"
              }
            }
          }
        },
        "canonicalOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://devrelay.dev/contracts/shared-artifacts.schema.json#/$defs/artifactPointer"
          }
        },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warnings",
            "unmappedContent"
          ],
          "properties": {
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "unmappedContent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        }
      }
    }
  }
}
