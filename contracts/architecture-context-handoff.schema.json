{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/architecture-context-handoff/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "priorSnapshotDigest",
    "activationDigest",
    "snapshot",
    "receipt",
    "state",
    "discoverySnapshot",
    "route",
    "files",
    "invalidatedBindings",
    "lifecycleComplete",
    "handoffDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "devrelay.dev/v1alpha1"
    },
    "kind": {
      "const": "DesktopArchitectureContextHandoff"
    },
    "priorSnapshotDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "activationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "snapshot": {
      "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/sessionSnapshot"
    },
    "receipt": {
      "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/sessionReceipt"
    },
    "state": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "discoverySnapshot": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "route": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "https://devrelay.dev/host/local-requirements-gate-commit/v1#/$defs/artifactBytes"
      }
    },
    "invalidatedBindings": {
      "type": "array",
      "items": {
        "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/contextBinding"
      }
    },
    "lifecycleComplete": {
      "const": false
    },
    "handoffDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
