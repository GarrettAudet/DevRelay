{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/requirements-context-boundary/v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "gateCommitDigest", "runtimeGraph", "activationReceipt", "invalidatedBindings", "progressionAllowed"],
  "properties": {
    "kind": { "const": "DesktopRequirementsContextBoundary" },
    "gateCommitDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "runtimeGraph": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" },
    "activationReceipt": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" },
    "invalidatedBindings": { "type": "array", "items": { "$ref": "https://devrelay.dev/contracts/roadmap-management-artifacts.schema.json#/$defs/contextBinding" } },
    "progressionAllowed": { "const": false }
  }
}
