{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/contracts/quality-policy-artifacts.schema.json",
  "title": "DevRelay QualityPolicy artifacts",
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rule": {
      "type": "object",
      "required": ["id", "priority", "appliesTo", "obligations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer" },
        "appliesTo": { "type": "object", "required": ["riskLevels", "workTypes", "technologies", "surfaces"], "properties": { "riskLevels": { "type": "array", "uniqueItems": true }, "workTypes": { "type": "array", "uniqueItems": true }, "technologies": { "type": "array", "uniqueItems": true }, "surfaces": { "type": "array", "uniqueItems": true } }, "additionalProperties": false },
        "obligations": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "lane", "evidenceKinds", "minimumPassing", "independent", "deferAllowed"], "properties": { "id": { "type": "string", "minLength": 1 }, "lane": { "type": "string", "minLength": 1 }, "evidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true }, "minimumPassing": { "type": "integer", "minimum": 1 }, "independent": { "type": "boolean" }, "deferAllowed": { "type": "boolean" } }, "additionalProperties": false }
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "type": "object", "required": ["apiVersion", "kind", "policyId", "version", "previousBaselineDigest", "rules", "sourceRefs"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityPolicyInput" }, "policyId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "previousBaselineDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }, "sourceRefs": { "type": "array", "uniqueItems": true } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "profileName", "profileVersion", "catalogDigest", "projectRiskContext", "closurePolicy", "authorityPolicy", "executionPolicy", "verificationPolicy", "description", "interfaceIntentId", "policyId", "policyDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "ResolvedWorkflowProfile" }, "profileName": { "type": "string" }, "profileVersion": { "type": "string" }, "catalogDigest": { "$ref": "#/$defs/digest" }, "projectRiskContext": { "type": "object" }, "closurePolicy": { "type": "object" }, "authorityPolicy": { "type": "object" }, "executionPolicy": { "type": "object" }, "verificationPolicy": { "type": "object" }, "description": { "type": "string" }, "interfaceIntentId": { "const": "IF-SIM-PROFILE" }, "policyId": { "type": "string" }, "policyDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "riskContext", "changedSurfaces", "technologies", "acceptanceCriterionIds", "contextDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityPolicyContext" }, "riskContext": { "type": "object", "required": ["level", "sourceRefs"], "properties": { "level": { "type": "string", "minLength": 1 }, "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false }, "changedSurfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "technologies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "acceptanceCriterionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "contextDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "policyId", "version", "previousBaselineDigest", "rules", "sourceRefs", "candidateDigest", "authority"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityPolicyCandidate" }, "policyId": { "type": "string" }, "version": { "type": "string" }, "previousBaselineDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }, "sourceRefs": { "type": "array", "uniqueItems": true }, "candidateDigest": { "$ref": "#/$defs/digest" }, "authority": { "const": "candidate-only" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "policyId", "version", "previousBaselineDigest", "rules", "sourceRefs", "candidateDigest", "approval", "baselineDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityPolicyBaseline" }, "policyId": { "type": "string" }, "version": { "type": "string" }, "previousBaselineDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }, "sourceRefs": { "type": "array", "uniqueItems": true }, "candidateDigest": { "$ref": "#/$defs/digest" }, "approval": { "type": "object", "required": ["kind", "authority", "decision", "candidateDigest"], "properties": { "kind": { "const": "QualityPolicyGateApproval" }, "authority": { "type": "string", "minLength": 1 }, "decision": { "const": "approve" }, "candidateDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }, "baselineDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "authority", "decision", "resolutionDigest", "obligationId", "rationale", "approvalDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityPolicyWaiverApproval" }, "authority": { "type": "string", "minLength": 1 }, "decision": { "const": "approve" }, "resolutionDigest": { "$ref": "#/$defs/digest" }, "obligationId": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "approvalDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "policyBaselineDigest", "workflowPolicyDigest", "workItemId", "context", "qualityPolicyContextDigest", "acceptanceCriterionIds", "appliedRuleIds", "obligations", "authority", "resolutionDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityObligationResolution" }, "policyBaselineDigest": { "$ref": "#/$defs/digest" }, "workflowPolicyDigest": { "$ref": "#/$defs/digest" }, "workItemId": { "type": "string" }, "context": { "type": "object" }, "qualityPolicyContextDigest": { "$ref": "#/$defs/digest" }, "acceptanceCriterionIds": { "type": "array", "uniqueItems": true }, "appliedRuleIds": { "type": "array", "uniqueItems": true }, "obligations": { "type": "array" }, "authority": { "type": "object" }, "resolutionDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    { "type": "object", "required": ["apiVersion", "kind", "resolutionDigest", "coverage", "decision", "authority", "assessmentDigest"], "properties": { "apiVersion": { "const": "devrelay.dev/v1alpha1" }, "kind": { "const": "QualityEvidenceAssessment" }, "resolutionDigest": { "$ref": "#/$defs/digest" }, "coverage": { "type": "array" }, "decision": { "enum": ["satisfied", "block"] }, "authority": { "const": "evidence-assessment-only" }, "assessmentDigest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  ]
}
