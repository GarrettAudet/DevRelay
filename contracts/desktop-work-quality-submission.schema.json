{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-work-quality-submission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "readinessDigest", "workItemId", "qualityPolicy", "qualityContext", "artifacts"],
  "properties": {
    "kind": { "const": "DesktopWorkQualitySubmission" },
    "readinessDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workItemId": { "type": "string", "pattern": "^WI-[A-Z0-9-]+$" },
    "qualityPolicy": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" },
    "qualityContext": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" },
    "artifacts": { "type": "array", "items": { "$ref": "https://devrelay.dev/host/desktop-local-configuration/v1#/$defs/artifactFile" } }
  }
}
