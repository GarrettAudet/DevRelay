{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-assignment-gate-submission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "approval",
    "artifacts"
