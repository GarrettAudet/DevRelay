{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-specialist-assignment-inputs/v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "module", "operation", "dependencyActivationDigest", "inputs", "lifecycleComplete"],
  "properties": {
    "kind": { "const": "LocalSpecialistAssignmentInputs" },
    "module": { "const": { "id": "specialist-assignment", "version": "3.0.0" } },
    "operation": { "const": "assign-specialists" },
    "dependencyActivationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["work-breakdown-baseline", "work-dependency-baseline", "project-overview-baseline", "capability-catalog", "repository-context", "specialist-catalog", "assignment-policy"],
      "properties": {
        "work-breakdown-baseline": { "$ref": "#/$defs/ref" },
        "work-dependency-baseline": { "$ref": "#/$defs/ref" },
        "project-overview-baseline": { "$ref": "#/$defs/ref" },
        "capability-catalog": { "$ref": "#/$defs/ref" },
        "repository-context": { "$ref": "#/$defs/ref" },
        "specialist-catalog": { "$ref": "#/$defs/ref" },
        "assignment-policy": { "$ref": "#/$defs/ref" }
      }
    },
    "lifecycleComplete": { "const": false }
  },
  "$defs": { "ref": { "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef" } }
}
