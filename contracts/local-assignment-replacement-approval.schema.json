{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/local-assignment-replacement-approval/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "approvalId",
    "namespace",
    "projectId",
    "priorBaseline",
    "priorActivationDigest",
    "targetDraft",
    "checkpointDigest",
    "executionFingerprint",
    "workBreakdownBaseline",
    "workDependencyBaseline",
    "authority",
    "decision",
    "scope",
    "evidence"
  ],
  "properties": {
    "apiVersion": {
      "const": "devrelay.dev/v1alpha1"
    },
    "kind": {
      "const": "LocalAssignmentReplacementApproval"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "priorBaseline": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "priorActivationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "targetDraft": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "checkpointDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executionFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workBreakdownBaseline": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "workDependencyBaseline": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "authority": {
      "const": "project-owner"
    },
    "decision": {
      "const": "approve-replacement"
    },
    "scope": {
      "const": "assignment-baseline-publication"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
      }
    }
  }
}
