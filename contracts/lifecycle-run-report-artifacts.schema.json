    "completionFact":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","completionId","workItem","changeSet","verification","integration","status","authority","completionDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"IntegratedCompletionFact"},"completionId":{"$ref":"#/$defs/id"},"workItem":{"$ref":"#/$defs/ref"},"changeSet":{"$ref":"#/$defs/ref"},"verification":{"$ref":"#/$defs/ref"},"integration":{"$ref":"#/$defs/ref"},"status":{"const":"verified-and-integrated"},"authority":{"const":"factual-completion"},"completionDigest":{"$ref":"#/$defs/digest"}}},
    "workDisposition":{"type":"object","additionalProperties":false,"required":["workItemId","status"],"properties":{"workItemId":{"$ref":"#/$defs/id"},"status":{"enum":["ready","blocked","completed","failed-dependency"]},"blockingWorkItemIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "readyFrontier":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","frontierId","workDependencyBaseline","completionFacts","derivation","dispositions","readyWorkItemIds","authority","frontierDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"ReadyFrontier"},"frontierId":{"$ref":"#/$defs/id"},"workDependencyBaseline":{"$ref":"#/$defs/ref"},"completionFacts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},"derivation":{"type":"object","additionalProperties":false,"required":["algorithm","version","inputDigest"],"properties":{"algorithm":{"const":"approved-dag-plus-integrated-completion"},"version":{"const":"1.0.0"},"inputDigest":{"$ref":"#/$defs/digest"}}},"dispositions":{"type":"array","items":{"$ref":"#/$defs/workDisposition"}},"readyWorkItemIds":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"authority":{"const":"core-derived-readiness"},"frontierDigest":{"$ref":"#/$defs/digest"}}}
