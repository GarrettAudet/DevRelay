    "stage":{"type":"object","additionalProperties":false,"required":["componentKind","componentId","sequence","operation","adapterBindings","status","outcome","gateResult","rework","performance","importantArtifacts","nextAction","sourceFacts"],"properties":{"componentKind":{"enum":["module","gate","core-service"]},"componentId":{"$ref":"#/$defs/id"},"sequence":{"type":"integer","minimum":0},"operation":{"type":"string","minLength":1},"adapterBindings":{"type":"array","items":{"$ref":"#/$defs/adapterBinding"}},"status":{"enum":["not-started","active","completed","failed","clarification","skipped","blocked"]},"outcome":{"enum":["candidate","approved","rejected","completed","failed","clarification","skipped","not-applicable","unknown"]},"gateResult":{"enum":["approved","rejected","pending","not-applicable","unknown"]},"rework":{"type":"object","additionalProperties":false,"required":["attemptCount","replayed","predecessorAttempts"],"properties":{"attemptCount":{"type":"integer","minimum":0},"replayed":{"type":"boolean"},"predecessorAttempts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ref"}}}},"performance":{"type":"array","items":{"$ref":"#/$defs/metric"}},"importantArtifacts":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},"nextAction":{"$ref":"#/$defs/nextAction"},"sourceFacts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}}}},
    "traceabilityPath":{"type":"object","additionalProperties":false,"required":["pathId","from","to","graphEvidence"],"properties":{"pathId":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/ref"},"to":{"$ref":"#/$defs/ref"},"graphEvidence":{"$ref":"#/$defs/ref"}}},
