    "dimension":{"type":"object","additionalProperties":false,"required":["name","leftDigest","rightDigest","matches"],"properties":{"name":{"enum":["module","operation","inputs","policy","circuit","host"]},"leftDigest":{"$ref":"#/$defs/digest"},"rightDigest":{"$ref":"#/$defs/digest"},"matches":{"type":"boolean"}}},
    "comparability":{"type":"object","additionalProperties":false,"required":["apiVersion","kind","decisionId","leftRunId","rightRunId","dimensions","disposition","reasons","authority","decisionDigest"],"properties":{"apiVersion":{"const":"devrelay.dev/v1alpha1"},"kind":{"const":"RunComparabilityDecision"},"decisionId":{"$ref":"#/$defs/id"},"leftRunId":{"$ref":"#/$defs/id"},"rightRunId":{"$ref":"#/$defs/id"},"dimensions":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/dimension"}},"disposition":{"enum":["comparable","not-comparable"]},"reasons":{"type":"array","items":{"type":"string","minLength":1}},"authority":{"const":"comparison-only"},"decisionDigest":{"$ref":"#/$defs/digest"}}},
    "policyRule":{"type":"object","additionalProperties":false,"required":["classification","disposition"],"properties":{"classification":{"enum":["public","internal","restricted","secret","credential","prompt","raw-tool-log","unknown"]},"disposition":{"enum":["allow","omit","redact"]}}},
