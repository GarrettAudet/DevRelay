{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/desktop-external-execution-request/v1",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "execution", "repeatAllowed", "requestDigest"],
  "properties": {
    "kind": { "const": "DesktopExternalExecutionRequest" },
    "repeatAllowed": { "const": false },
    "requestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "runId", "attemptId", "workItemId", "repositoryRevision", "worktree", "executor", "requiredCapabilities", "requiredGrants", "idempotencyKey", "bindingDigest"],
      "properties": {
        "phase": { "const": "effect-started" },
        "runId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "workItemId": { "type": "string", "minLength": 1 },
        "repositoryRevision": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "executor": { "type": "object", "required": ["id", "version", "configurationDigest"], "properties": {
          "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 },
          "configurationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        } },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "requiredGrants": { "type": "array", "items": { "type": "string" } },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "bindingDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
