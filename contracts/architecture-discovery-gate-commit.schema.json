{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devrelay.dev/host/architecture-discovery-gate-commit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "policyVersion",
    "scope",
    "interpretationRef",
    "ownerApprovalRef",
    "invocationDigest",
    "discoverySnapshot",
    "priorState",
    "nextState",
    "evidence",
    "commitDigest"
  ],
  "properties": {
    "apiVersion": {
      "const": "devrelay.dev/v1alpha1"
    },
    "kind": {
      "const": "ArchitectureDiscoveryGateCommit"
    },
    "policyVersion": {
      "const": "architecture-discovery-gate/0.1.0"
    },
    "scope": {
      "const": "observational-discovery-readiness"
    },
    "interpretationRef": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "ownerApprovalRef": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "invocationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "discoverySnapshot": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "priorState": {
      "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
    },
    "nextState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "utf8",
        "byteLength"
      ],
      "properties": {
        "ref": {
          "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
        },
        "utf8": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "byteLength"
        ],
        "properties": {
          "ref": {
            "$ref": "https://devrelay.dev/contracts/module-result.schema.json#/$defs/artifactRef"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "commitDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
