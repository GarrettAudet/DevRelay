  "kind": "ModuleDefinition",
  "metadata": {
    "id": "work-breakdown",
    "version": "0.2.0",
    "description": "Add exactly one code/test work item within unchanged approved scope; reviewed design reuse binds current repository evidence without rewriting historical architecture."
  },
  "routing": {
