        "unable_to_proceed": {
          "status": "completed",
          "requiredInputs": [],
          "forbiddenInputs": [],
          "requiredOutputs": [],
          "allowedOutputs": [],
          "requiredEvidence": [],
          "diagnosticsRequired": true
        },
        "execution_failed": {
          "status": "failed",
          "requiredInputs": [],
          "forbiddenInputs": [],
          "requiredOutputs": [],
          "allowedOutputs": [],
          "requiredEvidence": [],
          "diagnosticsRequired": true
        }
      },
      "evidence": [
        "work-breakdown/contract-validation",
        "work-breakdown/source-closure"
      ],
      "optionsSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
