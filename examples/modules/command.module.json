{
  "apiVersion": "devrelay.dev/v1alpha1",
  "kind": "ModuleDefinition",
  "metadata": {
    "id": "command",
    "version": "0.1.0",
    "description": "Execute one command-shaped operation and return a canonical report."
  },
  "operations": [
    {
      "id": "run",
      "description": "Execute a command against one workspace artifact.",
      "inputs": [
        {
          "name": "workspace",
          "schema": "https://devrelay.dev/artifacts/workspace/v1",
          "mediaTypes": [
            "application/vnd.devrelay.workspace+json"
          ],
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "report",
          "schema": "https://devrelay.dev/artifacts/command-report/v1",
          "mediaTypes": [
            "application/json"
          ],
          "cardinality": "one",
          "required": false
        }
      ],
      "outcomes": [
        "completed",
        "command_failed",
        "execution_failed"
      ],
      "resultContracts": {
        "completed": {
          "status": "completed",
          "requiredInputs": [],
          "requiredOutputs": [
            "report"
          ],
          "allowedOutputs": [
            "report"
          ],
          "requiredEvidence": [
            {
              "kind": "command/execution",
              "statuses": [
                "pass"
              ],
              "artifactOutput": "report"
            }
          ],
          "diagnosticsRequired": false,
          "forbiddenInputs": []
        },
        "command_failed": {
          "status": "completed",
          "requiredInputs": [],
          "requiredOutputs": [
            "report"
          ],
          "allowedOutputs": [
            "report"
          ],
          "requiredEvidence": [
            {
              "kind": "command/execution",
              "statuses": [
                "fail"
              ],
              "artifactOutput": "report"
            }
          ],
          "diagnosticsRequired": true,
          "forbiddenInputs": []
        },
        "execution_failed": {
          "status": "failed",
          "requiredInputs": [],
          "requiredOutputs": [],
          "allowedOutputs": [],
          "requiredEvidence": [],
          "diagnosticsRequired": true,
          "forbiddenInputs": []
        }
      },
      "evidence": [
        "command/execution"
      ],
      "optionsSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "inputRules": []
    }
  ]
}
