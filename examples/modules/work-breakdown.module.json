{
  "apiVersion": "devrelay.dev/v1alpha1",
  "kind": "ModuleDefinition",
  "metadata": {
    "id": "work-breakdown",
    "version": "0.1.0",
    "description": "Convert exact approved scope into one complete candidate set of bounded, traceable, independently executable and verifiable work items without executing the work."
  },
  "routing": {
    "stateSchema": "https://devrelay.dev/artifacts/project-work-breakdown-state/v1",
    "discriminator": "/state",
    "rules": [
      {
        "value": "unbaselined",
        "operation": "establish-breakdown",
        "reasonCode": "WORK_BREAKDOWN_BASELINE_ABSENT"
      },
      {
        "value": "baselined",
        "operation": "decompose-change",
        "reasonCode": "WORK_BREAKDOWN_BASELINE_PRESENT"
      }
    ],
    "stateInput": "project-work-breakdown-state",
    "decisionInput": "routing-decision"
  },
  "operations": [
    {
      "id": "establish-breakdown",
      "description": "Create one WorkBreakdownDraft from exact approved project baselines and an explicit repository disposition.",
      "adapterExecution": "effect",
      "inputs": [
        {
          "name": "project-work-breakdown-state",
          "schema": "https://devrelay.dev/artifacts/project-work-breakdown-state/v1",
