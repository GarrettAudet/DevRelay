          "require": [
            "clarification-responses",
            "continuation"
          ]
        },
        {
          "ifPresent": "clarification-responses",
          "require": [
            "clarification-request",
            "continuation"
          ]
        },
        {
          "ifPresent": "continuation",
          "require": [
            "clarification-request",
            "clarification-responses"
          ]
        },
        {
          "ifPresent": "revision-request",
          "require": [],
          "forbid": [
            "clarification-request",
            "clarification-responses",
            "continuation"
          ]
        }
      ],
      "outcomes": [
        "decomposed",
        "needs_clarification",
        "baseline_drift",
        "unable_to_proceed",
        "execution_failed"
      ],
      "resultContracts": {
        "decomposed": {
          "status": "completed",
          "requiredInputs": [
            "project-work-breakdown-state",
            "routing-decision",
            "requirements-baseline",
            "project-overview-baseline",
            "architecture-baseline",
