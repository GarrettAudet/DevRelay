          "mediaTypes": [
            "application/vnd.devrelay.contract-disposition+json"
          ],
          "cardinality": "one",
          "required": true
        },
        {
          "name": "capability-catalog",
          "schema": "https://devrelay.dev/artifacts/capability-catalog/v1",
          "mediaTypes": [
            "application/vnd.devrelay.capability-catalog+json"
          ],
          "cardinality": "one",
          "required": true
        },
