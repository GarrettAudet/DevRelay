{
  "apiVersion": "devrelay.dev/v1alpha1",
  "kind": "ModuleDefinition",
  "metadata": {
    "id": "openspec",
    "version": "0.1.0",
    "description": "Adapt selected OpenSpec operations to generic DevRelay artifacts and evidence."
  },
  "operations": [
    {
      "id": "proposal",
      "description": "Create or update an OpenSpec proposal from a goal artifact.",
      "execution": "effect",
      "inputs": [
        {
          "name": "goal",
          "schema": "https://devrelay.dev/artifacts/goal/v1",
          "mediaTypes": [
            "text/markdown",
            "text/plain"
          ],
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "proposal",
          "schema": "https://devrelay.dev/artifacts/requirements-proposal/v1",
          "mediaTypes": [
            "text/markdown"
          ],
          "cardinality": "one",
          "required": true
        }
      ],
      "outcomes": [
        "generated",
        "generation_failed"
      ],
      "evidence": [],
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectRoot",
          "changeName"
        ],
        "properties": {
          "projectRoot": {
            "type": "string",
            "minLength": 1
          },
          "changeName": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "capabilities": [
        {
          "kind": "filesystem.read",
          "scope": "config:projectRoot"
        },
        {
          "kind": "filesystem.write",
          "scope": "config:projectRoot/openspec/changes"
        },
        {
          "kind": "process.spawn",
          "scope": "openspec"
        }
      ]
    },
    {
      "id": "validate",
      "description": "Run strict native validation and normalize its result as evidence.",
      "execution": "effect",
      "inputs": [
        {
          "name": "change",
          "schema": "https://devrelay.dev/artifacts/requirements-package/v1",
          "mediaTypes": [
            "application/vnd.devrelay.requirements+json"
          ],
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "validation-report",
          "schema": "https://devrelay.dev/artifacts/verification-report/v1",
          "mediaTypes": [
            "application/json"
          ],
          "cardinality": "one",
          "required": true
        }
      ],
      "outcomes": [
        "valid",
        "invalid",
        "validation_failed"
      ],
      "evidence": [
        "requirements/structural-validation"
      ],
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectRoot"
        ],
        "properties": {
          "projectRoot": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "capabilities": [
        {
          "kind": "filesystem.read",
          "scope": "config:projectRoot"
        },
        {
          "kind": "process.spawn",
          "scope": "openspec"
        }
      ]
    }
  ]
}
