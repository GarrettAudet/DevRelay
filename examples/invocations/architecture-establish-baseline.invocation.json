{
  "apiVersion": "devrelay.dev/v1alpha1",
  "kind": "ModuleInvocation",
  "invocationId": "architecture-establish-baseline-001",
  "runId": "architecture-run-001",
  "nodeId": "architecture-design",
  "module": {
    "id": "architecture-design",
    "version": "0.1.0",
    "operation": "establish-baseline"
  },
  "adapters": [
    {
      "step": "designer",
      "plugin": {
        "id": "spec-kit-plan",
        "version": "0.1.0"
      },
      "config": {
        "projectRoot": "/workspace",
        "toolVersion": "fixture-0.1.0",
        "featureName": "authentication-baseline",
        "command": "/speckit.plan",
        "bridge": "agent-command"
      },
      "grants": [
        {
          "kind": "filesystem.read",
          "scope": "/workspace"
        },
        {
          "kind": "filesystem.write",
          "scope": "/workspace/specs"
        },
        {
          "kind": "process.spawn",
          "scope": "specify"
        },
        {
          "kind": "network.connect",
          "scope": "host:implementation-engine"
        }
      ]
    },
    {
      "step": "modeler",
      "plugin": {
        "id": "structurizr",
        "version": "0.1.0"
      },
      "config": {
        "projectRoot": "/workspace",
        "toolVersion": "fixture-0.1.0",
        "workspacePath": "architecture/workspace.dsl",
        "exportFormat": "mermaid"
      },
      "grants": [
        {
          "kind": "filesystem.read",
          "scope": "/workspace"
        },
        {
          "kind": "filesystem.write",
          "scope": "/workspace/architecture"
        },
        {
          "kind": "process.spawn",
          "scope": "structurizr-cli"
        }
      ]
    },
    {
      "step": "decision-recorder",
      "plugin": {
        "id": "madr",
        "version": "0.1.0"
      },
      "config": {
        "projectRoot": "/workspace",
        "templateVersion": "4.0",
        "decisionsPath": "/workspace/architecture/decisions"
      },
      "grants": [
        {
          "kind": "filesystem.read",
          "scope": "/workspace"
        },
        {
          "kind": "filesystem.write",
          "scope": "/workspace/architecture/decisions"
        }
      ]
    }
  ],
  "inputs": {
    "project-architecture-state": [
      {
        "artifactId": "project-architecture-state-existing-discovered-001",
        "schema": "https://devrelay.dev/artifacts/project-architecture-state/v1",
        "mediaType": "application/vnd.devrelay.project-architecture-state+json",
        "digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "uri": "file:///workspace/.devrelay/artifacts/project-architecture-state-existing-discovered-001.json"
      }
    ],
    "routing-decision": [
      {
        "artifactId": "module-route-decision-establish-001",
        "schema": "https://devrelay.dev/artifacts/module-route-decision/v1",
        "mediaType": "application/vnd.devrelay.module-route-decision+json",
        "digest": "sha256:ffe9bc55e8f5d7442c8047f48e833f87943b853ba5baa2166145824de7f45d64",
        "uri": "file:///workspace/.devrelay/artifacts/module-route-decision-establish-001.json"
      }
    ],
    "requirements-baseline": [
      {
        "artifactId": "requirements-baseline-001",
        "schema": "https://devrelay.dev/artifacts/requirements-baseline/v1",
        "mediaType": "application/vnd.devrelay.requirements-baseline+json",
        "digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "uri": "file:///workspace/.devrelay/artifacts/requirements-baseline-001.json"
      }
    ],
    "project-context": [
      {
        "artifactId": "project-context-001",
        "schema": "https://devrelay.dev/artifacts/project-context/v1",
        "mediaType": "application/vnd.devrelay.project-context+json",
        "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "uri": "file:///workspace/.devrelay/artifacts/project-context-001.json"
      }
    ],
    "repository-snapshot": [
      {
        "artifactId": "repository-snapshot-001",
        "schema": "https://devrelay.dev/artifacts/repository-snapshot/v1",
        "mediaType": "application/vnd.devrelay.repository-snapshot+json",
        "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "uri": "file:///workspace/.devrelay/artifacts/repository-snapshot-001.json"
      }
    ],
    "current-architecture-snapshot": [
      {
        "artifactId": "current-architecture-snapshot-001",
