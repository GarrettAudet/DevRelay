        "mediaType": "application/vnd.devrelay.current-architecture-snapshot+json",
        "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
        "uri": "file:///workspace/.devrelay/artifacts/current-architecture-snapshot-001.json"
      }
    ]
  },
  "options": {}
