    "current-architecture-snapshot": [
      {
        "artifactId": "current-architecture-snapshot-001",
        "schema": "https://devrelay.dev/artifacts/current-architecture-snapshot/v1",
        "mediaType": "application/vnd.devrelay.current-architecture-snapshot+json",
        "digest": "sha256:229bdb3e99feafb253c1ce09b3236062135e6105c26104075e63c7f553586cc2",
        "uri": "file:///workspace/.devrelay/artifacts/current-architecture-snapshot-001.json"
      }
    ],
    "project-overview-baseline": [
      {
        "artifactId": "project-overview-baseline-001",
        "schema": "https://devrelay.dev/artifacts/project-overview-baseline/v1",
        "mediaType": "application/vnd.devrelay.project-overview-baseline+json",
        "digest": "sha256:d9b03d8908eeed7430317d0eafbe545641a50c2d5b5b1a099e1bf74858f236fc",
        "uri": "file:///workspace/.devrelay/artifacts/project-overview-baseline-001.json"
      }
    ]
  },
  "options": {}
}
