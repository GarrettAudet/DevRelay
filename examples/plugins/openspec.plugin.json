{
  "apiVersion": "devrelay.dev/v1alpha1",
  "kind": "ModulePlugin",
  "metadata": {
    "id": "openspec",
    "version": "0.1.0",
    "description": "Contract mapping for normalizing OpenSpec proposal and spec artifacts into RequirementsGathering."
  },
  "implements": [
    {
      "module": {
        "id": "requirements-gathering",
        "version": "0.1.0"
      },
      "operations": [
        {
          "id": "gather",
          "execution": "effect",
          "configSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projectRoot",
              "toolName",
              "toolVersion",
              "nativeOperation",
              "changeName",
              "schema",
              "bridge"
            ],
            "properties": {
              "projectRoot": {
                "type": "string",
                "minLength": 1
              },
              "toolName": {
                "const": "OpenSpec"
              },
              "toolVersion": {
                "type": "string",
                "minLength": 1
              },
              "nativeOperation": {
                "const": "requirements.gather"
              },
              "changeName": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "const": "devrelay-requirements"
              },
              "bridge": {
                "const": "agent-command"
              }
            }
          },
          "capabilities": [
            {
              "kind": "filesystem.read",
              "scope": "config:projectRoot"
            },
            {
              "kind": "filesystem.write",
              "scope": "config:projectRoot/openspec/changes"
            },
            {
              "kind": "network.connect",
              "scope": "host:implementation-engine"
            }
          ]
        }
      ]
    }
  ]
}
