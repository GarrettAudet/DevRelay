  "technicalDesign": {
    "mode": "embedded",
    "content": {
      "technicalDesignId": "TD-AUTH-001",
      "objective": "Establish a provider-neutral authentication architecture.",
      "scope": {
        "level": "feature",
        "boundary": "Authentication and session establishment.",
        "in": [
          "Authentication request handling",
          "Credential verification",
          "Session establishment"
        ],
        "out": [
          "Detailed API schemas",
          "Implementation tasks"
        ]
      },
      "problemSummary": "Authentication must establish sessions without revealing whether an account exists.",
      "solutionSummary": "Centralize credential verification, failure normalization, and session creation behind one service boundary.",
      "requirementsDrivers": [
        "Registered users can authenticate.",
        "Externally visible failures do not reveal account existence."
      ],
      "behaviorFlows": [
        "A user submits authentication input to the authentication service.",
        "The service verifies credentials and either creates a session or returns a uniform failure."
      ],
      "dataResponsibilities": [
        "The identity source owns credential-verification material.",
        "The authentication service owns session-establishment policy."
      ],
      "failureHandling": [
        "Normalize invalid-identity and invalid-credential outcomes."
      ],
      "securityPrivacy": [
        "Protect credential material in transit and at rest.",
        "Do not expose identity-source details."
      ],
      "performanceReliabilityOperability": [
        "Authentication telemetry must not contain credential material."
      ],
      "compatibilityMigrationRollout": [
        "Preserve externally uniform failure behavior during migration."
      ],
      "verificationIntent": [
        "Security review compares externally visible failures.",
        "Architecture tests verify the intended dependency direction."
      ],
      "interfaceIntentIds": [
        "IF-AUTHENTICATE"
      ],
      "constraintIds": [
        "CON-AUTH-FAILURE"
      ],
      "sourceRequirementIds": [
        "CON-AUTH-NONDISCLOSURE-001",
        "NFR-AUTH-PERFORMANCE-001",
        "US-AUTH-SESSION-001"
      ],
      "sourceRefs": []
    }
  },
  "interfaceIntent": {
    "mode": "embedded",
    "content": {
      "interfaceIntentSetId": "INTERFACES-AUTH-001",
      "interfaces": [
        {
          "id": "IF-AUTHENTICATE",
          "name": "Authenticate user",
          "purpose": "Request credential verification and session establishment.",
          "ownerBoundary": "Authentication service",
          "providerElementId": "EL-AUTH-SERVICE",
          "consumerElementIds": [
            "EL-CLIENT"
          ],
          "interactionStyle": "synchronous",
          "semanticInputs": [
            "Presented identity and credential material"
          ],
          "semanticOutputs": [
            "Established session or uniform authentication failure"
          ],
          "protocolConstraints": [
            "Credential material is protected in transit."
          ],
          "failureBehavior": "Return one externally uniform failure and establish no session.",
          "compatibilityObligations": [
            "Preserve success-versus-uniform-failure semantics."
          ],
          "securityPrivacyIntent": [
            "Do not disclose whether an identity exists."
          ],
          "deliveryConsistencyIntent": [
            "A successful response means session state is established."
          ],
          "contractGeneration": {
            "required": true,
            "suggestedKinds": [
              "openapi"
            ]
          },
          "sourceRequirementIds": [
            "CON-AUTH-NONDISCLOSURE-001",
            "NFR-AUTH-PERFORMANCE-001",
            "US-AUTH-SESSION-001"
          ],
          "sourceRefs": []
        }
      ]
    }
  },
  "architectureConstraints": {
    "mode": "embedded",
    "content": {
      "constraintSetId": "CONSTRAINTS-AUTH-001",
      "constraints": [
        {
          "id": "CON-AUTH-FAILURE",
          "category": "security",
          "strength": "must",
          "statement": "Externally visible authentication failures must not disclose identity existence.",
          "rationale": "Account enumeration is an unacceptable security exposure.",
          "appliesTo": [
            {
              "kind": "element",
              "id": "EL-AUTH-SERVICE"
            },
            {
              "kind": "interface",
              "id": "IF-AUTHENTICATE"
            }
          ],
          "verificationIntent": "Compare responses and timing for existing and nonexistent identities.",
          "sourceRequirementIds": [
