      "decisions": [
        {
          "id": "ADR-AUTH-001",
          "title": "Centralize authentication policy",
          "status": "accepted",
          "contextAndProblemStatement": "Credential verification, failure normalization, and session establishment need one accountable architectural boundary.",
          "decisionDrivers": [
            "Uniform security behavior",
            "Provider independence",
            "Traceable session ownership"
          ],
          "consideredOptions": [
            {
              "id": "OPT-CENTRAL-SERVICE",
              "title": "Central authentication service",
              "pros": [
                "One policy owner"
              ],
              "cons": [
                "Adds a runtime dependency"
              ]
            },
            {
              "id": "OPT-CLIENT-VERIFICATION",
              "title": "Client-owned verification",
              "pros": [
                "Avoids one service hop"
              ],
              "cons": [
                "Duplicates security policy"
              ]
            }
          ],
          "outcome": {
            "chosenOptionId": "OPT-CENTRAL-SERVICE",
            "justification": "One boundary can enforce non-enumerating failures consistently."
          },
          "consequences": [
            {
              "polarity": "positive",
              "statement": "Authentication behavior has one accountable owner."
            },
            {
              "polarity": "negative",
              "statement": "Authentication depends on service availability."
            }
          ],
          "confirmation": "Architecture and security verification confirm dependency direction and uniform failures.",
